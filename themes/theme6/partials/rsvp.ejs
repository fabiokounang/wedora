<section id="rsvp" class="py-20 px-4" style="background: linear-gradient(180deg, #FFF0F0 0%, #FFFAF7 100%);">
  <div class="max-w-lg mx-auto">
    <h2 class="font-serif text-3xl md:text-4xl text-center text-gray-800 mb-4 fade-in">RSVP</h2>
    <p class="text-center text-gray-500 mb-10 fade-in">We'd love to have you there</p>
    <form id="rsvp-form" class="bg-white rounded-3xl p-8 shadow-sm space-y-5 fade-in">
      <div>
        <label for="rsvp-name" class="block text-sm font-medium text-gray-600 mb-1">Your Name</label>
        <input type="text" id="rsvp-name" name="guest_name" required class="w-full px-4 py-3 rounded-xl border border-rose-light/50 focus:outline-none focus:border-rose-soft focus:ring-2 focus:ring-rose-soft/20 transition-all bg-rose-pale/30" placeholder="Enter your name" />
      </div>
      <div>
        <label for="rsvpPhone" class="block text-sm font-medium text-gray-600 mb-1">WhatsApp / Phone</label>
        <input type="tel" id="rsvpPhone" name="guest_phone" inputmode="tel" autocomplete="tel" class="w-full px-4 py-3 rounded-xl border border-rose-light/50 focus:outline-none focus:border-rose-soft focus:ring-2 focus:ring-rose-soft/20 transition-all bg-rose-pale/30" placeholder="08… / 628…" />
      </div>
      <div>
        <label for="rsvp-attend" class="block text-sm font-medium text-gray-600 mb-1">Will you attend?</label>
        <select id="rsvp-attend" name="attendance" required class="w-full px-4 py-3 rounded-xl border border-rose-light/50 focus:outline-none focus:border-rose-soft focus:ring-2 focus:ring-rose-soft/20 transition-all bg-rose-pale/30">
          <option value="">Select...</option>
          <option value="yes">Joyfully Accept</option>
          <option value="no">Respectfully Decline</option>
        </select>
      </div>
      <div>
        <label for="rsvp-guests" class="block text-sm font-medium text-gray-600 mb-1">Number of Guests</label>
        <input type="number" id="rsvp-guests" name="guests_count" min="1" max="10" value="1" class="w-full px-4 py-3 rounded-xl border border-rose-light/50 focus:outline-none focus:border-rose-soft focus:ring-2 focus:ring-rose-soft/20 transition-all bg-rose-pale/30" />
      </div>
      <div>
        <label for="rsvp-notes" class="block text-sm font-medium text-gray-600 mb-1">Notes / Dietary Requirements</label>
        <textarea id="rsvp-notes" name="notes" rows="3" class="w-full px-4 py-3 rounded-xl border border-rose-light/50 focus:outline-none focus:border-rose-soft focus:ring-2 focus:ring-rose-soft/20 transition-all bg-rose-pale/30 resize-none" placeholder="Any message for the couple..."></textarea>
      </div>
      <button type="submit" id="rsvp-btn" class="w-full py-3 bg-rose-soft text-white font-medium rounded-xl hover:bg-[#D88A8A] transition-colors shadow-sm">Send RSVP</button>
      <div id="rsvp-success" class="hidden text-center py-3 bg-green-50 text-green-700 rounded-xl text-sm">✨ Thank you! Your RSVP has been recorded.</div>
      <div id="rsvp-error" class="hidden text-center py-3 bg-red-50 text-red-600 rounded-xl text-sm"></div>
    </form>
  </div>
</section>
