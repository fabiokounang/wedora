<section class="t19-reveal t19-section-pad t19-center">
  <h2 class="t19-script t19-section-heading">Wishes &amp; Prayers</h2>
  <form id="t19-wish-form" class="t19-glass-card t19-form-card">
    <label class="t19-field">
      <span class="t19-label">Nama Anda</span>
      <input type="text" id="t19-wish-name" class="t19-input" placeholder="Nama">
    </label>
    <label class="t19-field">
      <span class="t19-label">Pesan &amp; Doa</span>
      <textarea id="t19-wish-msg" rows="3" class="t19-input" placeholder="Tulis doa dan ucapan..."></textarea>
    </label>
    <button type="submit" class="t19-btn t19-btn-full">Kirim Ucapan</button>
  </form>
  <div id="t19-wish-list" class="t19-wish-list"></div>
</section>
