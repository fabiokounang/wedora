<div id="t19-cover">
  <div id="t19-particles" class="t19-particles-wrap"></div>
  <!-- Floral emoji ornaments -->
  <div class="t19-floral-emojis" aria-hidden="true">
    <span class="t19-emoji t19-emoji--tl t19-swing">🌸</span>
    <span class="t19-emoji t19-emoji--tr t19-swing" style="animation-delay:-1.5s;">🌺</span>
    <span class="t19-emoji t19-emoji--bl t19-swing" style="animation-delay:-3s;">🍃</span>
    <span class="t19-emoji t19-emoji--br t19-swing" style="animation-delay:-0.7s;">🌷</span>
    <span class="t19-emoji t19-emoji--ml t19-swing" style="animation-delay:-2s;">🌼</span>
    <span class="t19-emoji t19-emoji--mr t19-swing" style="animation-delay:-4s;">🌹</span>
  </div>
  <div class="t19-cover-slide">
    <div class="t19-glass-card t19-cover-card">
      <p class="t19-sans t19-eyebrow"><%= coverSubtitle %></p>
      <h1 class="t19-script t19-cover-names"><%= p1f %> &amp; <%= p2f %></h1>
      <p class="t19-cover-date"><%= heroDateLabel %></p>
      <div class="t19-cover-divider"></div>
      <button id="t19-open-btn" class="t19-open-btn">Open Invitation</button>
    </div>
  </div>
</div>
