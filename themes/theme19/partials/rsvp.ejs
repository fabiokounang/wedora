<section class="t19-reveal t19-section-pad t19-center">
  <h2 class="t19-script t19-section-heading">RSVP</h2>
  <form id="t19-rsvp-form" class="t19-glass-card t19-form-card">
    <label class="t19-field">
      <span class="t19-label">Nama Anda</span>
      <input type="text" id="t19-rsvp-name" class="t19-input" placeholder="Nama lengkap" required>
    </label>
    <label class="t19-field">
      <span class="t19-label">Kehadiran</span>
      <div class="t19-radio-group">
        <label class="t19-radio-pill"><input type="radio" name="t19-attend" value="yes" checked> Hadir</label>
        <label class="t19-radio-pill"><input type="radio" name="t19-attend" value="no"> Tidak Hadir</label>
      </div>
    </label>
    <label class="t19-field">
      <span class="t19-label">Jumlah Tamu</span>
      <input type="number" id="t19-rsvp-guests" class="t19-input" min="1" max="10" value="1">
    </label>
    <button type="submit" class="t19-btn t19-btn-full">Kirim RSVP</button>
  </form>
</section>
