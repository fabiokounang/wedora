<section class="t19-reveal t19-section-pad">
  <h2 class="t19-script t19-section-heading">Gallery</h2>
  <div id="t19-gallery" class="t19-gallery-track">
    <% if (gallery && gallery.length > 0) { %>
      <% for (const img of gallery) { %>
      <div class="t19-gallery-slide">
        <img src="<%= img.url || img.image_url %>" alt="<%= img.caption || 'Gallery' %>" class="t19-gallery-img">
      </div>
      <% } %>
    <% } else { %>
      <% for (let i = 0; i < 6; i++) { %>
      <div class="t19-gallery-slide t19-gallery-empty">
        <i data-lucide="image" style="width:2.5rem;height:2.5rem;color:#c9a87a;opacity:0.4;"></i>
      </div>
      <% } %>
    <% } %>
  </div>
</section>
