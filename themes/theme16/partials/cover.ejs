<div id="cover" class="t16-cover fixed inset-0 z-50 flex items-center justify-center">
  <div class="absolute top-6 left-6 w-16 h-16 border-t-2 border-l-2 border-[#d4af37] opacity-40 rounded-tl-lg pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-6 right-6 w-16 h-16 border-t-2 border-r-2 border-[#d4af37] opacity-40 rounded-tr-lg pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-6 left-6 w-16 h-16 border-b-2 border-l-2 border-[#d4af37] opacity-40 rounded-bl-lg pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-6 right-6 w-16 h-16 border-b-2 border-r-2 border-[#d4af37] opacity-40 rounded-br-lg pointer-events-none" aria-hidden="true"></div>
  <div class="text-center px-6 max-w-md">
    <p class="text-sm tracking-[0.3em] text-[#8b7355]/80 uppercase mb-4 animate-fade-in delay-1"><%= coverSubtitle %></p>
    <h1 class="font-serif-elegant text-5xl md:text-7xl font-light text-[#3d3128] mb-2 leading-tight animate-fade-in delay-2"><%= coverNameLine %></h1>
    <p class="text-[#8b7355] tracking-[0.2em] text-sm mt-4 mb-10 animate-fade-in delay-3"><%= heroDateLabel %></p>
    <button type="button" id="open-btn" class="btn-glow text-white px-10 py-4 rounded-full text-sm tracking-[0.2em] uppercase font-medium animate-fade-in delay-4">Buka undangan</button>
  </div>
</div>
