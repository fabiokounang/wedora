<section class="py-20 px-6 section-hidden" data-section>
  <div class="max-w-xl mx-auto">
    <h2 class="font-serif-elegant text-3xl md:text-4xl text-center text-[#3d3128] mb-4">Ucapan &amp; doa</h2>
    <p class="text-center text-[#8b7355] mb-10">Tinggalkan berkah untuk mempelai</p>
    <form id="wishForm" class="glass-card p-8 space-y-5 mb-6">
      <div>
        <label for="wishName" class="block text-sm text-[#6b5a4a] mb-1">Nama</label>
        <input id="wishName" type="text" required class="t16-input" placeholder="Nama Anda" autocomplete="name">
      </div>
      <div>
        <label for="wishMsg" class="block text-sm text-[#6b5a4a] mb-1">Ucapan</label>
        <textarea id="wishMsg" rows="4" required class="t16-input t16-textarea" placeholder="Tuliskan ucapan atau doa…"></textarea>
      </div>
      <button type="submit" id="wishBtn" class="btn-glow w-full text-white py-3 rounded-full text-sm tracking-wider uppercase font-medium">Kirim ucapan</button>
    </form>
    <div id="wishesList" class="space-y-3">
      <% if (wishes && wishes.length) { %>
        <% wishes.forEach(function (w) { %>
          <div class="glass-card p-4 t16-wish-card">
            <% if (w.message) { %><p class="text-sm text-[#5a4a3a]">&ldquo;<%= w.message %>&rdquo;</p><% } %>
            <p class="text-xs text-[#8b7355] mt-1">&mdash; <%= w.guest_name %></p>
          </div>
        <% }); %>
      <% } else { %>
        <p id="noWishes" class="text-center text-sm text-[#8b7355] italic">Jadilah yang pertama meninggalkan ucapan hangat.</p>
      <% } %>
    </div>
  </div>
</section>
