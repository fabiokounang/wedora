<section class="t16-hero min-h-[600px] flex items-center justify-center px-6 py-20 section-hidden" data-section>
  <div class="text-center max-w-lg">
    <p class="text-[#8b7355] tracking-[0.3em] uppercase text-xs mb-6"><%= heroIntro %></p>
    <h1 class="font-serif-elegant text-5xl md:text-8xl font-light text-[#3d3128] leading-tight">
      <%= partnerOne %><br><span class="italic text-[#d4af37] text-4xl md:text-6xl">&amp;</span><br><%= partnerTwo %>
    </h1>
    <div class="w-20 h-px bg-[#d4af37] mx-auto my-8 opacity-60"></div>
    <p class="text-[#8b7355] tracking-[0.15em] text-base"><%= heroDateLabel %></p>
    <% if (heroVenueLine) { %>
      <p class="text-xs text-[#8b7355]/70 mt-2"><%= heroVenueLine %></p>
    <% } %>
  </div>
</section>
