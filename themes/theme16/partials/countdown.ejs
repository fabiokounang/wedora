<section class="py-20 px-6 text-center t16-countdown-bg section-hidden" data-section>
  <div class="max-w-3xl mx-auto">
    <h2 class="font-serif-elegant text-3xl md:text-4xl text-[#3d3128] mb-4">Menuju hari H</h2>
    <p class="text-[#8b7355] mb-10">Hingga kami mengucapkan ikrar</p>
    <div id="countdown" class="grid grid-cols-4 gap-4 max-w-md mx-auto">
      <div class="countdown-box p-4">
        <span id="cd-days" class="font-serif-elegant text-3xl text-[#3d3128] block">00</span>
        <span class="text-[#8b7355] text-xs uppercase tracking-wider mt-1">Hari</span>
      </div>
      <div class="countdown-box p-4">
        <span id="cd-hours" class="font-serif-elegant text-3xl text-[#3d3128] block">00</span>
        <span class="text-[#8b7355] text-xs uppercase tracking-wider mt-1">Jam</span>
      </div>
      <div class="countdown-box p-4">
        <span id="cd-mins" class="font-serif-elegant text-3xl text-[#3d3128] block">00</span>
        <span class="text-[#8b7355] text-xs uppercase tracking-wider mt-1">Menit</span>
      </div>
      <div class="countdown-box p-4">
        <span id="cd-secs" class="font-serif-elegant text-3xl text-[#3d3128] block">00</span>
        <span class="text-[#8b7355] text-xs uppercase tracking-wider mt-1">Detik</span>
      </div>
    </div>
  </div>
</section>
