<section class="py-20 px-6 section-hidden" data-section>
  <div class="max-w-lg mx-auto text-center">
    <h2 class="font-serif-elegant text-4xl text-amber-900/80 italic mb-10">Menuju hari H</h2>
    <div id="countdown" class="grid grid-cols-4 gap-4">
      <div class="card-romantic rounded-xl p-4">
        <span id="cd-days" class="font-serif-elegant text-3xl text-amber-800/80 block">00</span>
        <span class="text-xs text-amber-700/40 tracking-widest">HARI</span>
      </div>
      <div class="card-romantic rounded-xl p-4">
        <span id="cd-hours" class="font-serif-elegant text-3xl text-amber-800/80 block">00</span>
        <span class="text-xs text-amber-700/40 tracking-widest">JAM</span>
      </div>
      <div class="card-romantic rounded-xl p-4">
        <span id="cd-mins" class="font-serif-elegant text-3xl text-amber-800/80 block">00</span>
        <span class="text-xs text-amber-700/40 tracking-widest">MENIT</span>
      </div>
      <div class="card-romantic rounded-xl p-4">
        <span id="cd-secs" class="font-serif-elegant text-3xl text-amber-800/80 block">00</span>
        <span class="text-xs text-amber-700/40 tracking-widest">DETIK</span>
      </div>
    </div>
  </div>
</section>
