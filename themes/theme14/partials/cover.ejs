<div id="cover" class="fixed inset-0 z-50 flex items-center justify-center">
  <div class="text-center px-6 max-w-md">
    <div class="mb-6 animate-fade-in">
      <svg viewBox="0 0 200 60" class="w-40 mx-auto opacity-60" fill="none" aria-hidden="true">
        <path d="M100 5 C80 5 60 20 50 35 C40 20 20 10 10 15 C20 25 35 35 50 35 C60 50 80 55 100 55 C120 55 140 50 150 35 C165 35 180 25 190 15 C180 10 160 20 150 35 C140 20 120 5 100 5Z" stroke="#d4af37" stroke-width="0.8" fill="none" />
      </svg>
    </div>
    <p class="text-sm tracking-[0.3em] text-amber-700/60 uppercase mb-4 animate-fade-in delay-1"><%= coverSubtitle %></p>
    <h1 id="cover-names" class="font-serif-elegant text-5xl md:text-6xl text-amber-900/80 font-light italic mb-3 animate-fade-in delay-2"><%= coverNameLine %></h1>
    <div class="ornament-line mx-auto my-4 animate-fade-in delay-3"></div>
    <p id="cover-date" class="text-sm tracking-widest text-amber-700/50 mb-10 animate-fade-in delay-3"><%= heroDateLabel %></p>
    <button type="button" id="open-btn" class="btn-romantic text-white px-10 py-3.5 rounded-full text-sm tracking-widest uppercase animate-fade-in delay-4">Buka undangan</button>
    <div class="mt-8 animate-fade-in delay-5">
      <svg viewBox="0 0 200 40" class="w-32 mx-auto opacity-40" fill="none" aria-hidden="true">
        <path d="M20 20 Q60 5 100 20 Q140 35 180 20" stroke="#d4af37" stroke-width="0.8" />
        <circle cx="100" cy="20" r="3" fill="#d4af37" opacity="0.4" />
      </svg>
    </div>
  </div>
</div>
