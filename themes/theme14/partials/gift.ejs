<section class="py-20 px-6 section-hidden" data-section>
  <div class="max-w-md mx-auto text-center">
    <h2 class="font-serif-elegant text-4xl text-amber-900/80 italic mb-4">Amplop digital</h2>
    <p class="text-sm text-amber-700/50 mb-8"><%= content.gift_message || 'Kehadiran Anda adalah hadiah terindah. Jika berkenan memberi tanda kasih:' %></p>
    <div class="t14-gift-wrap text-left">
      <%- include('../../shared/partials/gift-cards.ejs', { gifts }) %>
    </div>
    <% if (!gifts || !gifts.length) { %>
      <p class="text-xs text-amber-700/45 mt-4">Rekening dapat diatur di panel admin (koleksi amplop digital).</p>
    <% } %>
  </div>
</section>
