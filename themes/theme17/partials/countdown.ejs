<section class="t17-reveal-section t17-section-pad t17-countdown-section">
  <h2 class="t17-serif t17-section-heading">Counting Down</h2>
  <div class="t17-glass-card t17-countdown-card">
    <div class="t17-countdown-grid">
      <div class="t17-countdown-item">
        <span id="cd-days" class="t17-serif t17-countdown-num">00</span>
        <p class="t17-countdown-label">Days</p>
      </div>
      <div class="t17-countdown-item">
        <span id="cd-hours" class="t17-serif t17-countdown-num">00</span>
        <p class="t17-countdown-label">Hours</p>
      </div>
      <div class="t17-countdown-item">
        <span id="cd-mins" class="t17-serif t17-countdown-num">00</span>
        <p class="t17-countdown-label">Minutes</p>
      </div>
      <div class="t17-countdown-item">
        <span id="cd-secs" class="t17-serif t17-countdown-num">00</span>
        <p class="t17-countdown-label">Seconds</p>
      </div>
    </div>
  </div>
</section>
