<section class="t17-reveal-section t17-section-pad t17-rsvp-section">
  <h2 class="t17-serif t17-section-heading">RSVP</h2>
  <form id="t17-rsvp-form" class="t17-glass-card t17-form-card">
    <label class="t17-form-label-wrap">
      <span class="t17-label">Nama Anda</span>
      <input type="text" id="t17-rsvp-name" class="t17-input" placeholder="Nama lengkap" required>
    </label>
    <label class="t17-form-label-wrap">
      <span class="t17-label">Kehadiran</span>
      <div class="t17-radio-group">
        <label class="t17-radio-pill"><input type="radio" name="t17-attend" value="yes" checked> Hadir</label>
        <label class="t17-radio-pill"><input type="radio" name="t17-attend" value="no"> Tidak Hadir</label>
      </div>
    </label>
    <label class="t17-form-label-wrap">
      <span class="t17-label">Jumlah Tamu</span>
      <input type="number" id="t17-rsvp-guests" class="t17-input" min="1" max="10" value="1">
    </label>
    <button type="submit" class="t17-btn-shimmer t17-btn-full">Kirim RSVP</button>
  </form>
</section>
