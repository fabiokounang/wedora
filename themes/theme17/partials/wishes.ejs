<section class="t17-reveal-section t17-section-pad t17-wishes-section">
  <h2 class="t17-serif t17-section-heading">Wishes &amp; Prayers</h2>
  <form id="t17-wish-form" class="t17-glass-card t17-form-card">
    <label class="t17-form-label-wrap">
      <span class="t17-label">Nama Anda</span>
      <input type="text" id="t17-wish-name" class="t17-input" placeholder="Nama">
    </label>
    <label class="t17-form-label-wrap">
      <span class="t17-label">Pesan &amp; Doa</span>
      <textarea id="t17-wish-msg" rows="3" class="t17-input" placeholder="Tulis doa dan ucapan..."></textarea>
    </label>
    <button type="submit" class="t17-btn-shimmer t17-btn-full">Kirim Ucapan</button>
  </form>
  <div id="t17-wish-list" class="t17-wish-list"></div>
</section>
