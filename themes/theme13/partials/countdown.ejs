<section class="py-20 px-6 text-center">
  <div class="section-fade">
    <p class="font-sans-clean text-xs tracking-[4px] uppercase mb-8 opacity-50" style="color: #9a7b5b;">Counting Down To</p>
    <div id="countdown" class="flex justify-center gap-4 md:gap-8 flex-wrap">
      <div class="glass rounded-2xl p-4 md:p-6 min-w-[70px] glow-soft"><span id="cd-days" class="font-serif-elegant text-3xl md:text-4xl block" style="color: #5a4030;">00</span> <span class="text-xs tracking-[2px] uppercase opacity-50" style="color: #9a7b5b;">Days</span>
      </div>
      <div class="glass rounded-2xl p-4 md:p-6 min-w-[70px] glow-soft"><span id="cd-hours" class="font-serif-elegant text-3xl md:text-4xl block" style="color: #5a4030;">00</span> <span class="text-xs tracking-[2px] uppercase opacity-50" style="color: #9a7b5b;">Hours</span>
      </div>
      <div class="glass rounded-2xl p-4 md:p-6 min-w-[70px] glow-soft"><span id="cd-mins" class="font-serif-elegant text-3xl md:text-4xl block" style="color: #5a4030;">00</span> <span class="text-xs tracking-[2px] uppercase opacity-50" style="color: #9a7b5b;">Mins</span>
      </div>
      <div class="glass rounded-2xl p-4 md:p-6 min-w-[70px] glow-soft"><span id="cd-secs" class="font-serif-elegant text-3xl md:text-4xl block" style="color: #5a4030;">00</span> <span class="text-xs tracking-[2px] uppercase opacity-50" style="color: #9a7b5b;">Secs</span>
      </div>
    </div>
  </div>
</section>
