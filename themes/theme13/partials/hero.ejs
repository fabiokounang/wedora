<section class="min-h-[100%] flex flex-col items-center justify-center text-center px-6 relative">
  <div class="section-fade">
    <p class="font-sans-clean text-xs tracking-[5px] uppercase mb-4 opacity-50" style="color: #9a7b5b;">The Wedding of</p>
    <h1 id="hero-groom" class="font-serif-elegant text-5xl md:text-7xl font-light mb-2" style="color: #5a4030;"><%= partnerOne %></h1>
    <p class="font-serif-elegant text-2xl md:text-3xl italic opacity-60 my-2" style="color: #9a7b5b;">&amp;</p>
    <h1 id="hero-bride" class="font-serif-elegant text-5xl md:text-7xl font-light mb-8" style="color: #5a4030;"><%= partnerTwo %></h1>
    <div class="w-16 h-[1px] mx-auto mb-6" style="background: #d4a574;"></div>
    <p id="hero-date" class="font-sans-clean text-sm tracking-[3px] uppercase opacity-70" style="color: #7a6050;"><%= heroDateLabel %></p>
    <p id="hero-message" class="font-sans-clean text-sm mt-4 max-w-md mx-auto opacity-60" style="color: #7a6050;"><%= invitationMsg %></p>
  </div>
</section>
