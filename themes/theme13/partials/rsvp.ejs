<section class="py-20 px-6 max-w-lg mx-auto">
  <div class="section-fade text-center mb-10">
    <p class="font-sans-clean text-xs tracking-[4px] uppercase mb-3 opacity-50" style="color: #9a7b5b;">Be There</p>
    <h2 class="font-serif-elegant text-3xl md:text-4xl" style="color: #5a4030;">RSVP</h2>
  </div>
  <form id="rsvp-form" class="section-fade glass rounded-3xl p-8 space-y-5 glow-soft" autocomplete="on">
    <input type="hidden" name="guests_count" value="1" id="rsvp-guests-count">
    <div>
      <label for="rsvp-name" class="text-xs tracking-[2px] uppercase opacity-50 block mb-2" style="color: #9a7b5b;">Your Name</label>
      <input id="rsvp-name" name="guest_name" type="text" required class="w-full px-4 py-3 rounded-xl border text-sm bg-white/50 outline-none focus:ring-2" style="border-color: #e8d4be; color: #5a4030; --tw-ring-color: #d4a574;" placeholder="Enter your name">
    </div>
    <div>
      <label for="rsvp-attend" class="text-xs tracking-[2px] uppercase opacity-50 block mb-2" style="color: #9a7b5b;">Attendance</label>
      <select id="rsvp-attend" name="attendance" class="w-full px-4 py-3 rounded-xl border text-sm bg-white/50 outline-none focus:ring-2" style="border-color: #e8d4be; color: #5a4030; --tw-ring-color: #d4a574;">
        <option value="yes">Joyfully Accept</option>
        <option value="no">Regretfully Decline</option>
      </select>
    </div>
    <div>
      <label for="rsvp-msg" class="text-xs tracking-[2px] uppercase opacity-50 block mb-2" style="color: #9a7b5b;">Message</label>
      <textarea id="rsvp-msg" name="notes" rows="3" class="w-full px-4 py-3 rounded-xl border text-sm bg-white/50 outline-none focus:ring-2 resize-none" style="border-color: #e8d4be; color: #5a4030; --tw-ring-color: #d4a574;" placeholder="Leave a wish for the couple..."></textarea>
    </div>
    <button type="submit" id="rsvp-submit" class="btn-open w-full text-sm tracking-[2px] uppercase">Send RSVP</button>
    <p id="rsvp-success" class="text-center text-sm opacity-0 transition-opacity" style="color: #9a7b5b;">Thank you for your response! 💕</p>
  </form>
</section>
