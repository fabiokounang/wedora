<section class="py-20 px-6">
  <div class="section-fade text-center mb-12">
    <p class="font-sans-clean text-xs tracking-[4px] uppercase mb-3 opacity-50" style="color: #9a7b5b;">Moments</p>
    <h2 class="font-serif-elegant text-3xl md:text-4xl" style="color: #5a4030;">Gallery</h2>
  </div>
  <div class="section-fade grid grid-cols-2 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
    <% if (gallery && gallery.length) { %>
      <% gallery.forEach(function (g) {
           const gu = g.thumbnail_url || g.image_url;
      %>
        <div class="gallery-item has-image" style="background-image: url(<%- JSON.stringify(gu) %>);"></div>
      <% }); %>
    <% } else { %>
      <div class="gallery-item"></div>
      <div class="gallery-item"></div>
      <div class="gallery-item"></div>
      <div class="gallery-item"></div>
      <div class="gallery-item"></div>
      <div class="gallery-item"></div>
    <% } %>
  </div>
</section>
