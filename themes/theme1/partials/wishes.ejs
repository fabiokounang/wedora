<section id="wishes" class="w-full py-24 px-6 bg-beige">
  <div class="max-w-2xl mx-auto">
    <h2 class="font-serif text-4xl md:text-5xl text-center text-deep mb-4 fade-up">Guest Wishes</h2>
    <p class="text-center text-brown text-sm tracking-wide mb-12 fade-up">Leave your love and blessings</p>
    <form id="wish-form" class="flex gap-3 mb-8 fade-up">
      <input id="wish-name" name="guest_name" type="text" required placeholder="Your name" class="flex-shrink-0 w-28 bg-cream border border-sand rounded-xl px-3 py-3 text-sm text-deep placeholder-warm/50" />
      <input id="wish-msg" name="message" type="text" required placeholder="Write a wish…" class="flex-1 bg-cream border border-sand rounded-xl px-4 py-3 text-sm text-deep placeholder-warm/50" />
      <button type="submit" id="wish-btn" class="flex-shrink-0 w-11 h-11 rounded-full bg-brown text-cream flex items-center justify-center hover:bg-deep transition-colors duration-300" aria-label="Send wish">
        <img src="https://img.icons8.com/?size=96&id=53385&format=png&color=FAF8F5" alt="Send" class="icon icon-sm" />
      </button>
    </form>
    <div id="wishes-list" class="space-y-3"></div>
    <p id="wishes-empty" class="text-center text-warm text-sm italic py-8">Be the first to leave a wish &#128157;</p>
  </div>
</section>
