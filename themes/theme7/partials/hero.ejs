<section id="home" class="relative min-h-[600px] flex items-center justify-center pt-16" style="background: linear-gradient(135deg, #FFF5EE 0%, #FFF0F0 30%, #F7E0E0 60%, #F5D0D0 100%);">
  <div class="absolute top-20 left-10 opacity-20 heart-float">
    <svg width="60" height="60" viewBox="0 0 24 24" fill="#E8A0A0"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
  </div>
  <div class="absolute bottom-32 right-16 opacity-15 heart-float" style="animation-delay: 2s;">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="#E8A0A0"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
  </div>
  <div class="text-center px-6 fade-in">
    <p class="text-rose-soft font-medium tracking-widest uppercase text-sm mb-4"><%= content.hero_tagline || "We're getting married" %></p>
    <h1 class="font-serif text-5xl md:text-7xl font-light text-gray-800 mb-2"><%= content.partner_one %> &amp; <%= content.partner_two %></h1>
    <div class="flex items-center justify-center gap-3 my-6">
      <div class="h-px w-16 bg-rose-soft/50"></div>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="#E8A0A0"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
      <div class="h-px w-16 bg-rose-soft/50"></div>
    </div>
    <% const wd = helpers.toDate(content.wedding_date); %>
    <p class="font-serif text-2xl md:text-3xl text-gray-600 italic" id="hero-date-line">
      <%= wd ? helpers.formatDateTime(content.wedding_date) : '' %>
    </p>
    <p class="mt-6 text-gray-500 font-light max-w-md mx-auto" id="hero-message">
      <%= content.hero_message || 'With joy in our hearts, we invite you to celebrate the beginning of our forever.' %>
    </p>
  </div>
</section>
