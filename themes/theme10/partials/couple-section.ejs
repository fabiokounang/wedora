<%
  const cdAttr = countdownDateAttr(content.wedding_date);
  const wd = helpers.toDate(content.wedding_date);
  var calHref = '#';
  if (wd) {
    var pad = function (n) { return String(n).padStart(2, '0'); };
    var y = wd.getFullYear();
    var m = pad(wd.getMonth() + 1);
    var day = pad(wd.getDate());
    var sh = pad(wd.getHours());
    var sm = pad(wd.getMinutes());
    var start = y + m + day + 'T' + sh + sm + '00';
    var endD = new Date(wd.getTime() + 3 * 3600000);
    var end = endD.getFullYear() + pad(endD.getMonth() + 1) + pad(endD.getDate()) + 'T' + pad(endD.getHours()) + pad(endD.getMinutes()) + '00';
    calHref = 'https://www.google.com/calendar/render?action=TEMPLATE&text=' + encodeURIComponent('The Wedding of ' + (content.partner_one || '') + ' & ' + (content.partner_two || '')) + '&dates=' + start + '/' + end + '&ctz=Asia/Jakarta';
  }
  const storyFirst = (story && story[0]) ? story[0] : null;
  const proseHtml = (storyFirst && storyFirst.description) ? storyFirst.description : '<p><span style="color: #bdbdbd; font-size: 14pt; font-family: Athelas;">Neither of us knew, that one simple interaction on Instagram will change the course of both our lives. </span><span style="color: #bdbdbd; font-size: 14pt; font-family: Athelas;">Fast forward 6 years, multiple albums, medals, and 4 cats later, our love has grown deeper than ever. </span></p><p><span style="color: #bdbdbd; font-size: 14pt; font-family: Athelas;">It\'s time to take the step.</span></p>';
  const groomName = content.partner_one_full || content.partner_one || '';
  const brideName = content.partner_two_full || content.partner_two || '';
%>
