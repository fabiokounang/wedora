<!-- Gift / registry — egift-section class keeps Viding theme scripts compatible -->
            <section class="egift-section moveable-section" data-id="5">
                <div class="image-wrapper">
                    <div class="background-element">
                        <img data-src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:1200:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvYmctd2lzaGVzLTIucG5n.webp" alt="bg-gift" class="lazyload">
                    </div>
                </div>
                <div class="orn-1">
                    <div class="image-element" data-anim="fade-right">
                        <img src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:0:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvbGVhZi0xLnBuZw.webp" alt="leaf-1" class="img-fluid animate-loop" data-anim="rotate-right">
                    </div>
                </div>
                <div class="orn-2">
                    <div class="image-element" data-anim="fade-right">
                        <img src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:0:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvcm9zZS0xLnBuZw.webp" alt="rose-1" class="img-fluid animate-loop" data-anim="rotate-left" data-anim-duration="5000ms">
                    </div>
                </div>
                <div class="container position-relative py-4 py-md-5">
                    <div class="row justify-content-center">
                        <div class="col-md-10 col-lg-8 col-xl-7 text-center position-relative" style="z-index: 3;">
                            <div class="title-section" data-anim="rotate-left">
                                <h2><span style="color: #ffffff; font-size: 18pt; font-family: Athelas;">Gift</span></h2>
                            </div>
                            <p class="text-center mb-4" style="color: rgba(255,255,255,0.9); font-family: Athelas, serif;"><%= content.gift_message || 'Your presence is our greatest gift.' %></p>
                            <div class="d-flex justify-content-center">
                                <div class="w-100" style="max-width: 24rem;">
                                    <%- include('../../shared/partials/gift-cards.ejs', { gifts }) %>
                                </div>
                            </div>
                            <% if (!gifts || !gifts.length) { %>
                            <p class="text-center small mt-3" style="color: rgba(255,255,255,0.75);">Rekening / e-wallet dapat diatur di admin.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </section>
