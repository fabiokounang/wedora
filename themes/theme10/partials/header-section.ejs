<!-- Header section -->
        <section class="header-section  main-page">
            <div class="elements-wrapper-absolute">
                <div class="background-element">
                    <img src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:1200:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvcGF0dGVybi5wbmc.webp" alt="pattern">
                </div>
                <div class="orn-1">
                    <div class="image-element" data-anim="slide-down">
                        <img src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:0:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvbGVhZi0xLnBuZw.webp" alt="leaf-1" class="img-fluid animate-loop" data-anim="rotate-left">
                    </div>
                </div>
                <div class="orn-2">
                    <div class="imagme-element" data-anim="slide-rotate-left">
                        <img src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:0:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvcm9zZS0xLnBuZw.webp" alt="rose-1" class="img-fluid animate-loop" data-anim="rotate-left" data-anim-duration="5000ms">
                    </div>
                </div>
                <div class="orn-3">
                    <div class="image-element" data-anim="slide-rotate-up">
                        <img src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:0:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvcGFya2V0LnBuZw.webp" alt="parket" class="img-fluid animate-loop" data-anim="rotate-left">
                    </div>
                </div>
                <div class="orn-4">
                    <div class="image-element" data-anim="slide-down">
                        <img src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:0:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvbGVhZi0xLnBuZw.webp" alt="leaf-1" class="img-fluid animate-loop" data-anim="rotate-left">
                    </div>
                </div>
                <div class="orn-6">
                    <div class="image-element" data-anim="slide-up">
                        <img src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:0:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvbGVhZi0xLnBuZw.webp" alt="leaf-1" class="img-fluid animate-loop" data-anim="rotate-left">
                    </div>
                </div>
                <div class="orn-5">
                    <div class="image-element" data-anim="slide-rotate-left">
                        <img src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:0:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvcm9zZS0xLnBuZw.webp" alt="rose-1" class="img-fluid animate-loop" data-anim="rotate-left" data-anim-duration="6000ms">
                    </div>
                </div>
            </div>
            <div class="container h-100">
                <div class="row justify-content-center h-100">
                    <div class="col-md-12">
                        <div class="header-content">
                            <div class="header">
                                <div class="elements-wrapper-absolute">
                                    <div class="background-element">
                                        <img src="https://media.viding.co/dmlkaW5nIGNvIGltYWdlIHByb3h5IGJ5IGZseS5pbw/rs:auto:0:0:1/g:no/aHR0cHM6Ly90aGVtZXMudmlkaW5nLmNvL3RoZW1lXzk2L2Fzc2V0cy9pbWFnZXMvYmctaGVhZGVyLnBuZw.webp" alt="bg-header">
                                    </div>
                                </div>
                                <div class="header-title">
                                    <div class="scroll-icon">
                                        <svg data-anim="slide-down" width="28" height="42" viewBox="0 0 28 42" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <rect opacity="0.6" x="0.5" y="0.5" width="27" height="41" rx="13.5" stroke="#757346"></rect>
                                            <rect id="scroll-animate" opacity="0.6" x="12" y="6.66699" width="4" height="9.33333" rx="2" fill="#A79E74"></rect>
                                        </svg>
                                    </div>
                                    <div class="header-title-content">
                                                                                <div data-anim="rotate-left">
                                            <% if (content.hero_message) { %>
<%- content.hero_message %>
                                            <% } else { %>
                                            <p><span style="font-family: Athelas;">Dear family and friends,</span></p>
<p><span style="font-family: Athelas;">The day is finally coming, we are getting married!</span></p>
<p><span style="font-family: Athelas;">and this moment wouldn't be complete without you. </span></p>
<p><span style="font-family: Athelas;">Let's celebrate love.</span></p>
<p><span style="font-family: Athelas;">We hope to see you there,</span></p>
<p>&nbsp;</p>
<p><span style="font-family: Athelas;"><%= content.partner_one %> &amp; <%= content.partner_two %></span></p>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        