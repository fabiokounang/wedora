<section id="gift" class="relative z-10 py-20 px-6">

  <div class="max-w-lg mx-auto text-center">

    <p class="text-xs tracking-[0.4em] uppercase reveal" style="color:rgba(196,168,116,0.4);">Your presence is our present</p>

    <h2 class="font-serif-display mt-3 reveal" style="font-size:clamp(2rem,5vw,3.2rem);color:#c4a874;font-weight:300;">Digital Gift</h2>

    <div class="ornament-divider mt-4 mb-10 reveal" style="color:rgba(196,168,116,0.3);">&#10022;</div>

    <div class="glow-soft rounded-xl p-8 reveal" style="background:rgba(196,168,116,0.03);border:1px solid rgba(196,168,116,0.1);">

      <% if (content.gift_message) { %>

        <p class="text-sm mb-8" style="color:rgba(212,197,169,0.7);line-height:1.8;"><%= content.gift_message %></p>

      <% } %>

      <%- include('../../shared/partials/gift-cards.ejs', { gifts }) %>

      <% if (!gifts || gifts.length === 0) { %>

        <p class="text-sm mt-6" style="color:rgba(212,197,169,0.55);">Informasi rekening akan ditampilkan di sini.</p>

      <% } %>

    </div>

  </div>

</section>

