<section id="events" class="relative z-10 py-20 px-6">
  <div class="max-w-3xl mx-auto text-center">
    <p class="text-xs tracking-[0.4em] uppercase reveal" style="color:rgba(196,168,116,0.4);">Join us</p>
    <h2 class="font-serif-display mt-3 reveal" style="font-size:clamp(2rem,5vw,3.2rem);color:#c4a874;font-weight:300;">Celebration Details</h2>
    <div class="ornament-divider mt-4 mb-12 reveal" style="color:rgba(196,168,116,0.3);">&#10022;</div>
    <div class="grid md:grid-cols-2 gap-8">
      <% (events || []).forEach(function(ev, idx) {
           const iconId = idx % 2 === 0 ? 2737 : 61803;
      %>
      <div class="glow-soft rounded-xl p-8 reveal" style="background:rgba(196,168,116,0.03);border:1px solid rgba(196,168,116,0.1);">
        <div class="flex justify-center mb-4" style="color:#c4a874;">
          <img src="https://img.icons8.com/?size=96&id=<%= iconId %>&format=png&color=C4A874" alt="<%= ev.title %> icon" class="icon icon-lg" />
        </div>
        <h3 class="font-serif-display text-xl" style="color:#c4a874;"><%= ev.title %></h3>
        <% if (ev.datetime) { %>
          <p class="mt-3 text-sm" style="color:rgba(212,197,169,0.7);"><%= helpers.formatDateTime(ev.datetime) %></p>
        <% } %>
        <% if (ev.venue_name) { %>
          <p class="mt-2 font-serif-display text-lg" style="color:rgba(212,197,169,0.9);"><%= ev.venue_name %></p>
        <% } %>
        <% if (ev.address) { %>
          <p class="text-sm mt-1" style="color:rgba(212,197,169,0.5);"><%= ev.address %></p>
        <% } %>
        <% if (ev.map_url) { %>
          <a href="<%= ev.map_url %>" target="_blank" rel="noopener" class="inline-block mt-3 text-xs tracking-widest uppercase" style="color:#c4a874;">View Map</a>
        <% } %>
      </div>
      <% }) %>
      <% if (!events || events.length === 0) { %>
        <p class="text-center" style="color:rgba(196,168,116,0.4);">Event details coming soon...</p>
      <% } %>
    </div>
  </div>
</section>
