<%
  const sectionMap = {};
  for (const s of sections) sectionMap[s.section_key] = s;
  function hasSection(key) {
    const s = sectionMap[key];
    return !s || s.enabled === 1 || s.enabled === true;
  }
  const initials = (s) => (s || '').trim().charAt(0).toUpperCase();
  const brand = `${initials(content.partner_one)} & ${initials(content.partner_two)}`;
-%>
<!doctype html>
<html lang="id" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= content.partner_one %> &amp; <%= content.partner_two %> — Wedding Invitation</title>
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Questrial&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.5/css/lightbox.min.css" />
    <link rel="stylesheet" href="/themes/theme3/public/style.css" />
  </head>
  <body class="h-full">
    <div id="app" class="h-full w-full bg-candlelight overflow-auto font-body" style="color:#d4c5a9;">
      <div class="candle-particle" style="width:300px;height:300px;top:10%;left:15%;animation:flickerOne 6s ease-in-out infinite;"></div>
      <div class="candle-particle" style="width:200px;height:200px;top:30%;right:10%;animation:flickerTwo 8s ease-in-out infinite;"></div>
      <div class="candle-particle" style="width:250px;height:250px;bottom:20%;left:40%;animation:flickerOne 7s ease-in-out infinite 1s;"></div>

      <%- include('partials/nav', { brand, hasSection }) %>

      <% if (hasSection('hero')) { %><%- include('partials/hero') %><% } %>
      <% if (hasSection('story')) { %><%- include('partials/story', { story }) %><% } %>
      <% if (hasSection('events')) { %><%- include('partials/events', { events }) %><% } %>
      <% if (hasSection('gallery')) { %><%- include('partials/gallery', { gallery }) %><% } %>
      <% if (hasSection('rsvp')) { %><%- include('partials/rsvp') %><% } %>
      <% if (hasSection('gift')) { %><%- include('partials/gift', { gifts }) %><% } %>
      <% if (hasSection('wishes')) { %><%- include('partials/wishes', { wishes }) %><% } %>

      <%- include('partials/footer', { brand }) %>
    </div>
    <div id="toast" class="toast font-body text-sm"></div>

    <script>
      window.__SITE__ = {
        siteId: <%= site.id %>,
        slug: <%- JSON.stringify(site.slug) %>,
        apiBase: <%- JSON.stringify(apiBase) %>,
        weddingDate: <%- JSON.stringify(content.wedding_date || null) %>,
      };
      window.__WISHES__ = <%- JSON.stringify(wishes || []) %>;
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.5/js/lightbox.min.js"></script>
    <script src="/themes/theme3/public/script.js"></script>
    <%- include('../shared/music.ejs', { site }) %>
  </body>
</html>
