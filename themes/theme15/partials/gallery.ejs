<section class="py-20 px-6 section-hidden" data-section>
  <div class="max-w-3xl mx-auto">
    <h2 class="font-serif-elegant text-4xl text-center text-amber-900/80 italic mb-10">Galeri</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      <% if (gallery && gallery.length) { %>
        <% gallery.forEach(function (img) {
             const gu = img.thumbnail_url || img.image_url;
        %>
          <div class="gallery-item rounded-xl overflow-hidden aspect-square bg-amber-50/80">
            <img src="<%= gu %>" alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
        <% }); %>
      <% } else { %>
        <div class="gallery-item rounded-xl overflow-hidden aspect-square bg-gradient-to-br from-amber-50 to-rose-50 flex items-center justify-center">
          <i data-lucide="image" class="w-8 h-8 text-amber-300/50"></i>
        </div>
        <div class="gallery-item rounded-xl overflow-hidden aspect-[3/4] bg-gradient-to-br from-rose-50 to-amber-50 flex items-center justify-center row-span-2">
          <i data-lucide="image" class="w-8 h-8 text-rose-300/50"></i>
        </div>
        <div class="gallery-item rounded-xl overflow-hidden aspect-square bg-gradient-to-br from-amber-50 to-yellow-50 flex items-center justify-center">
          <i data-lucide="image" class="w-8 h-8 text-amber-300/50"></i>
        </div>
        <div class="gallery-item rounded-xl overflow-hidden aspect-square bg-gradient-to-br from-rose-50 to-pink-50 flex items-center justify-center">
          <i data-lucide="image" class="w-8 h-8 text-rose-300/50"></i>
        </div>
        <div class="gallery-item rounded-xl overflow-hidden aspect-square bg-gradient-to-br from-yellow-50 to-amber-50 flex items-center justify-center">
          <i data-lucide="image" class="w-8 h-8 text-amber-300/50"></i>
        </div>
        <div class="gallery-item rounded-xl overflow-hidden aspect-square bg-gradient-to-br from-amber-50 to-rose-50 flex items-center justify-center">
          <i data-lucide="image" class="w-8 h-8 text-amber-300/50"></i>
        </div>
      <% } %>
    </div>
  </div>
</section>
