<section class="t21-closing-section reveal-section" data-section>
  <div class="relative text-center px-6 z-10">
    <% if (content.footer_text) { %>
      <div class="text-lg max-w-sm mx-auto mb-8" style="color:var(--brown)"><%- content.footer_text %></div>
    <% } else { %>
      <p class="text-lg max-w-sm mx-auto mb-8" style="color:var(--brown)">Terima kasih atas kasih sayang dan doa restu Anda. Kehadiran Anda adalah kebahagiaan terbesar bagi kami.</p>
    <% } %>
    <p class="font-sans-alt text-xs tracking-[0.3em] uppercase mb-4" style="color:var(--taupe)">Dengan penuh cinta</p>
    <p class="font-script shimmer text-4xl" style="color:var(--gold)"><%= partnerOne %> &amp; <%= partnerTwo %></p>
  </div>
</section>
