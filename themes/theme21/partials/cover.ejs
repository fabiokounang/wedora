<section id="cover" class="t21-opening-screen">
  <div class="particles" id="t21-particles" aria-hidden="true"></div>
  <div id="t21-petals" aria-hidden="true"></div>
  <p class="font-sans-alt text-sm tracking-[0.3em] uppercase mb-8 animate-fade-in" style="color:var(--taupe)"><%= coverSubtitle %></p>
  <div class="envelope-wrapper">
    <div class="envelope">
      <div class="envelope-flap" id="t21-flap" aria-hidden="true"></div>
      <div class="seal" id="t21-seal" aria-hidden="true"><%= sealInitials %></div>
      <div class="envelope-body">
        <div class="invitation-card" id="t21-inv-card">
          <span class="font-script" style="color:var(--gold);font-size:1.2rem">Anda diundang</span>
        </div>
      </div>
      <div class="t21-glow" id="t21-glow" aria-hidden="true"></div>
    </div>
  </div>
  <button type="button" id="open-btn" class="mt-10 px-8 py-3 border border-[var(--gold)] text-[var(--gold)] font-sans-alt text-xs tracking-[0.25em] uppercase rounded-full t21-btn-open animate-fade-in">
    Buka undangan
  </button>
</section>
