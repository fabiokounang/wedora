<section class="t18-reveal t18-section-pad t18-center">
  <h2 class="t18-serif t18-section-heading">RSVP</h2>
  <form id="t18-rsvp-form" class="t18-form-card">
    <label class="t18-field">
      <span class="t18-label">Nama Anda</span>
      <input type="text" id="t18-rsvp-name" class="t18-input" placeholder="Nama lengkap" required>
    </label>
    <label class="t18-field">
      <span class="t18-label">Kehadiran</span>
      <div class="t18-radio-group">
        <label class="t18-radio-pill"><input type="radio" name="t18-attend" value="yes" checked> Hadir</label>
        <label class="t18-radio-pill"><input type="radio" name="t18-attend" value="no"> Tidak Hadir</label>
      </div>
    </label>
    <label class="t18-field">
      <span class="t18-label">Jumlah Tamu</span>
      <input type="number" id="t18-rsvp-guests" class="t18-input" min="1" max="10" value="1">
    </label>
    <button type="submit" class="t18-btn t18-btn-full">Kirim RSVP</button>
  </form>
</section>
