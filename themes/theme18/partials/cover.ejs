<div id="t18-cover">
  <!-- Floating floral ornaments -->
  <div class="t18-floral-wrap">
    <svg class="t18-floral t18-floral--tl" viewBox="0 0 180 180" fill="none">
      <circle cx="60" cy="60" r="30" fill="#f0e6d3" opacity="0.6"/>
      <path d="M60 30 Q75 50 60 70 Q45 50 60 30Z" fill="#e8c9a0" opacity="0.5"/>
      <path d="M30 60 Q50 75 70 60 Q50 45 30 60Z" fill="#c9d6b8" opacity="0.5"/>
      <circle cx="60" cy="60" r="8" fill="#d4a574" opacity="0.7"/>
      <path d="M10 10 Q40 20 70 10 Q50 40 10 10Z" fill="#e8c9a0" opacity="0.3"/>
    </svg>
    <svg class="t18-floral t18-floral--tr" viewBox="0 0 180 180" fill="none">
      <circle cx="110" cy="60" r="28" fill="#f0e6d3" opacity="0.6"/>
      <path d="M110 32 Q125 50 110 68 Q95 50 110 32Z" fill="#e8c9a0" opacity="0.5"/>
      <path d="M82 60 Q100 73 118 60 Q100 47 82 60Z" fill="#c9d6b8" opacity="0.5"/>
      <circle cx="110" cy="60" r="7" fill="#d4a574" opacity="0.7"/>
    </svg>
    <svg class="t18-floral t18-floral--bl" viewBox="0 0 160 160" fill="none">
      <path d="M40 120 Q80 80 120 120" stroke="#d4a574" stroke-width="1.5" fill="none"/>
      <circle cx="60" cy="110" r="10" fill="#e8c9a0" opacity="0.5"/>
      <circle cx="100" cy="105" r="8" fill="#c9d6b8" opacity="0.5"/>
    </svg>
    <svg class="t18-floral t18-floral--br" viewBox="0 0 160 160" fill="none">
      <circle cx="90" cy="100" r="25" fill="#f0e6d3" opacity="0.5"/>
      <path d="M65 100 Q90 75 115 100 Q90 125 65 100Z" fill="#e8c9a0" opacity="0.4"/>
      <circle cx="90" cy="100" r="6" fill="#d4a574" opacity="0.6"/>
    </svg>
  </div>
  <div class="t18-cover-content">
    <p class="t18-sans t18-eyebrow"><%= coverSubtitle %></p>
    <h1 class="t18-serif t18-cover-names"><%= p1f %> <em>&amp;</em> <%= p2f %></h1>
    <p class="t18-cover-date"><%= heroDateLabel %></p>
    <div class="t18-divider"></div>
    <button id="t18-open-btn" class="t18-open-btn">Open Invitation</button>
  </div>
</div>
