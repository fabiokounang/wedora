<section class="t18-reveal t18-section-pad t18-center t18-countdown-section">
  <h2 class="t18-serif t18-section-heading">Counting Down</h2>
  <div class="t18-countdown-row">
    <div class="t18-cd-cell"><span id="cd-days" class="t18-serif t18-cd-num">00</span><p class="t18-cd-label">Days</p></div>
    <span class="t18-serif t18-cd-sep">:</span>
    <div class="t18-cd-cell"><span id="cd-hours" class="t18-serif t18-cd-num">00</span><p class="t18-cd-label">Hours</p></div>
    <span class="t18-serif t18-cd-sep">:</span>
    <div class="t18-cd-cell"><span id="cd-mins" class="t18-serif t18-cd-num">00</span><p class="t18-cd-label">Minutes</p></div>
    <span class="t18-serif t18-cd-sep">:</span>
    <div class="t18-cd-cell"><span id="cd-secs" class="t18-serif t18-cd-num">00</span><p class="t18-cd-label">Seconds</p></div>
  </div>
</section>
