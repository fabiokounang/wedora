<section class="t18-reveal t18-section-pad">
  <h2 class="t18-serif t18-section-heading">Gallery</h2>
  <div class="t18-gallery-track-wrap">
    <div id="t18-gallery" class="t18-gallery-track">
      <% if (gallery && gallery.length > 0) { %>
        <% for (const img of gallery) { %>
        <div class="t18-gallery-slide">
          <img src="<%= img.url || img.image_url %>" alt="<%= img.caption || 'Gallery' %>" class="t18-gallery-img">
        </div>
        <% } %>
      <% } else { %>
        <% for (let i = 0; i < 6; i++) { %>
        <div class="t18-gallery-slide t18-gallery-empty">
          <i data-lucide="image" style="width:2rem;height:2rem;color:#c9a87a;opacity:0.4;"></i>
        </div>
        <% } %>
      <% } %>
    </div>
  </div>
</section>
