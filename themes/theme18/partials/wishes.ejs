<section class="t18-reveal t18-section-pad t18-center">
  <h2 class="t18-serif t18-section-heading">Wishes &amp; Prayers</h2>
  <form id="t18-wish-form" class="t18-form-card">
    <label class="t18-field">
      <span class="t18-label">Nama Anda</span>
      <input type="text" id="t18-wish-name" class="t18-input" placeholder="Nama">
    </label>
    <label class="t18-field">
      <span class="t18-label">Pesan &amp; Doa</span>
      <textarea id="t18-wish-msg" rows="3" class="t18-input" placeholder="Tulis doa dan ucapan..."></textarea>
    </label>
    <button type="submit" class="t18-btn t18-btn-full">Kirim Ucapan</button>
  </form>
  <div id="t18-wish-list" class="t18-wish-list"></div>
</section>
