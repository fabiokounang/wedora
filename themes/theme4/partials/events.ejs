<section id="event" class="section-pad" style="background: linear-gradient(180deg, var(--bg) 0%, var(--burgundy, #3d1420) 50%, var(--bg) 100%);">
  <div class="max-w-4xl mx-auto text-center">
    <div class="reveal">
      <p class="uppercase tracking-[5px] text-xs mb-3" style="color: var(--secondary);">Save The Date</p>
      <h2 class="font-serif-display text-3xl md:text-4xl font-light mb-4" style="color: var(--text);">Celebration Details</h2>
      <p class="text-sm mb-10" style="color: rgba(245, 230, 216, 0.55);"><%= content.events_subtitle || 'Join us for our special day' %></p>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      <% const icons = ['church', 'wine', 'music', 'heart']; %>
      <% (events || []).forEach(function (ev, idx) {
           const icon = icons[idx % icons.length];
           const d = ev.datetime ? helpers.toDate(ev.datetime) : null;
      %>
      <div class="reveal card-warm p-8 text-center">
        <div class="w-14 h-14 mx-auto rounded-full flex items-center justify-center mb-4" style="background: rgba(139, 41, 66, 0.4);">
          <i data-lucide="<%= icon %>" style="width: 24px; height: 24px; color: var(--secondary);"></i>
        </div>
        <h3 class="font-serif-display text-xl mb-1" style="color: var(--text);"><%= ev.title %></h3>
        <% if (d) { %>
          <p class="text-sm mb-2" style="color: var(--secondary);"><%= String(d.getHours()).padStart(2, '0') %>:<%= String(d.getMinutes()).padStart(2, '0') %></p>
        <% } %>
        <% if (ev.venue_name) { %><p class="text-sm font-semibold" style="color: var(--text);"><%= ev.venue_name %></p><% } %>
        <% if (ev.address) { %><p class="text-xs mt-1" style="color: rgba(245, 230, 216, 0.5);"><%= ev.address %></p><% } %>
        <% if (ev.map_url) { %>
          <a href="<%= ev.map_url %>" target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-xs uppercase tracking-wider" style="color: var(--secondary);">Map</a>
        <% } %>
      </div>
      <% }) %>
      <% if (!events || events.length === 0) { %>
        <p class="text-center col-span-full text-sm" style="color: rgba(245, 230, 216, 0.5);">Event details coming soon…</p>
      <% } %>
    </div>
  </div>
</section>
