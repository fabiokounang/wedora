<footer class="py-12 text-center" style="background: var(--bg); border-top: 1px solid rgba(201, 168, 124, 0.1);">
  <p class="font-serif-display text-2xl mb-2" style="color: var(--secondary);"><%= content.partner_one %> &amp; <%= content.partner_two %></p>
  <% const fd = helpers.toDate(content.wedding_date); %>
  <p class="text-xs tracking-wider" style="color: rgba(245, 230, 216, 0.4);">
    <%= fd ? helpers.formatDate(fd) : '' %> · With all our love
  </p>
  <div class="flex justify-center gap-1 mt-4">
    <i data-lucide="heart" style="width: 12px; height: 12px; color: var(--primary);"></i>
    <i data-lucide="heart" style="width: 12px; height: 12px; color: var(--secondary);"></i>
    <i data-lucide="heart" style="width: 12px; height: 12px; color: var(--primary);"></i>
  </div>
</footer>
