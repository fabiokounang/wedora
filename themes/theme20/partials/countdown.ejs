    <div class="t20-flame-card t20-cd-cell"><span id="cd-hours" class="t20-cinzel t20-cd-num">00</span><p class="t20-cd-label">Hours</p></div>
    <div class="t20-flame-card t20-cd-cell"><span id="cd-mins" class="t20-cinzel t20-cd-num">00</span><p class="t20-cd-label">Minutes</p></div>
    <div class="t20-flame-card t20-cd-cell"><span id="cd-secs" class="t20-cinzel t20-cd-num">00</span><p class="t20-cd-label">Seconds</p></div>
  </div>
