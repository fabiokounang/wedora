<section class="t20-reveal t20-section-pad t20-center">
  <h2 class="t20-cinzel t20-section-heading">Wishes &amp; Prayers</h2>
  <form id="t20-wish-form" class="t20-flame-card t20-form-card">
    <label class="t20-field">
      <span class="t20-label">Nama Anda</span>
      <input type="text" id="t20-wish-name" class="t20-input" placeholder="Nama">
    </label>
    <label class="t20-field">
      <span class="t20-label">Pesan &amp; Doa</span>
      <textarea id="t20-wish-msg" rows="3" class="t20-input" placeholder="Tulis doa dan ucapan..."></textarea>
    </label>
    <button type="submit" class="t20-btn t20-btn-full">Kirim Ucapan</button>
  </form>
  <div id="t20-wish-list" class="t20-wish-list"></div>
</section>
