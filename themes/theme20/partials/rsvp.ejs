<section class="t20-reveal t20-section-pad t20-center">
  <h2 class="t20-cinzel t20-section-heading">RSVP</h2>
  <form id="t20-rsvp-form" class="t20-flame-card t20-form-card">
    <label class="t20-field">
      <span class="t20-label">Nama Anda</span>
      <input type="text" id="t20-rsvp-name" class="t20-input" placeholder="Nama lengkap" required>
    </label>
    <label class="t20-field">
      <span class="t20-label">Kehadiran</span>
      <div class="t20-radio-group">
        <label class="t20-radio-pill"><input type="radio" name="t20-attend" value="yes" checked> Hadir</label>
        <label class="t20-radio-pill"><input type="radio" name="t20-attend" value="no"> Tidak Hadir</label>
      </div>
    </label>
    <label class="t20-field">
      <span class="t20-label">Jumlah Tamu</span>
      <input type="number" id="t20-rsvp-guests" class="t20-input" min="1" max="10" value="1">
    </label>
    <button type="submit" class="t20-btn t20-btn-full">Kirim RSVP</button>
  </form>
</section>
