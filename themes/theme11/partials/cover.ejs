<section class="cover-section cover-entrance" id="coverSection">
  <div class="cover-overlay"></div>
  <div class="sparkle" style="top:15%;left:20%;animation-delay:0s;"></div>
  <div class="sparkle" style="top:25%;right:15%;animation-delay:0.8s;"></div>
  <div class="sparkle" style="top:60%;left:12%;animation-delay:1.5s;"></div>
  <div class="sparkle" style="top:70%;right:20%;animation-delay:2.2s;"></div>
  <div class="sparkle" style="top:40%;left:50%;animation-delay:0.5s;"></div>
  <div class="sparkle" style="top:80%;left:35%;animation-delay:1.8s;"></div>
  <svg class="sway" style="position:absolute;top:20px;left:20px;opacity:0.25;width:80px;" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M10 90 Q10 10 90 10" stroke="#C9A84C" stroke-width="1.5" fill="none" /><path d="M15 80 Q20 40 50 20 Q30 50 15 80Z" fill="#8B2252" opacity="0.4" /><path d="M25 70 Q35 35 65 15 Q40 45 25 70Z" fill="#C9A84C" opacity="0.2" /></svg>
  <svg class="sway sway-delay" style="position:absolute;top:20px;right:20px;opacity:0.25;width:80px;transform:scaleX(-1);" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M10 90 Q10 10 90 10" stroke="#C9A84C" stroke-width="1.5" fill="none" /><path d="M15 80 Q20 40 50 20 Q30 50 15 80Z" fill="#8B2252" opacity="0.4" /></svg>
  <svg class="sway" style="position:absolute;bottom:20px;left:20px;opacity:0.25;width:80px;transform:scaleY(-1);" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M10 90 Q10 10 90 10" stroke="#C9A84C" stroke-width="1.5" fill="none" /><path d="M15 80 Q20 40 50 20 Q30 50 15 80Z" fill="#8B2252" opacity="0.4" /></svg>
  <svg class="sway sway-delay" style="position:absolute;bottom:20px;right:20px;opacity:0.25;width:80px;transform:scale(-1,-1);" viewBox="0 0 100 100" fill="none" aria-hidden="true"><path d="M10 90 Q10 10 90 10" stroke="#C9A84C" stroke-width="1.5" fill="none" /><path d="M15 80 Q20 40 50 20 Q30 50 15 80Z" fill="#8B2252" opacity="0.4" /></svg>
  <div class="invite-card">
    <p class="subtitle-entrance" style="font-size:0.75rem;letter-spacing:0.3em;color:var(--text-muted);text-transform:uppercase;margin-bottom:1rem;"><%= content.cover_subtitle || 'The Wedding of' %></p>
    <h1 class="font-serif-elegant names-entrance" style="font-size:clamp(2rem,8vw,3rem);font-weight:300;line-height:1.1;color:var(--warm-gold);"><%= content.partner_one || '—' %></h1>
    <div class="ornament-divider subtitle-entrance"><span class="ornament-line"></span><span class="ornament-diamond"></span><span class="ornament-line"></span></div>
    <h1 class="font-serif-elegant names-entrance" style="font-size:clamp(2rem,8vw,3rem);font-weight:300;line-height:1.1;color:var(--warm-gold);"><%= content.partner_two || '—' %></h1>
    <p class="subtitle-entrance" style="font-size:0.8rem;letter-spacing:0.2em;color:var(--text-muted);margin-top:1.5rem;"><%= helpers.formatDateTime(content.wedding_date) || helpers.formatDate(content.wedding_date) %></p>
    <button type="button" class="open-btn subtitle-entrance" id="openInviteBtn">Buka undangan</button>
  </div>
</section>
