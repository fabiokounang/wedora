<section id="wishes" class="py-24 px-6" style="background:#f0ede6">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-12 fade-up">
      <p class="text-xs tracking-[.3em] uppercase text-dusty-500 mb-3">Leave a blessing</p>
      <h2 class="font-serif text-sage-800 text-4xl sm:text-5xl" style="font-weight:300">Guest Wishes</h2>
    </div>
    <form id="wish-form" class="flex gap-3 mb-8 fade-up">
      <input id="wish-name" name="guest_name" type="text" required placeholder="Your name" class="flex-shrink-0 w-28 rounded-xl px-3 py-3 text-sm text-sage-800" style="background:rgba(255,255,255,.6);border:1px solid rgba(184,197,176,.3)" />
      <input id="wish-msg" name="message" type="text" required placeholder="Write a wish…" class="flex-1 rounded-xl px-4 py-3 text-sm text-sage-800" style="background:rgba(255,255,255,.6);border:1px solid rgba(184,197,176,.3)" />
      <button type="submit" id="wish-btn" class="flex-shrink-0 w-11 h-11 rounded-full text-ivory-100 flex items-center justify-center" style="background:#8a9e82" aria-label="Send">
        <img src="https://img.icons8.com/?size=96&id=53385&format=png&color=F7F5F0" alt="Send" class="icon icon-sm" />
      </button>
    </form>
    <div id="wishes-list" class="space-y-3"></div>
    <p id="wishes-empty" class="text-center text-sage-400 text-sm italic py-6">Be the first to leave a wish.</p>
  </div>
</section>
