<section id="gallery" class="py-24 px-6" style="background:#f0ede6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-12 fade-up">
      <p class="text-xs tracking-[.3em] uppercase text-dusty-500 mb-3">Moments</p>
      <h2 class="font-serif text-sage-800 text-4xl sm:text-5xl" style="font-weight:300">Gallery</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <% (gallery || []).forEach(function(item, idx) { %>
        <a href="<%= item.image_url %>" data-lightbox="theme2-gallery" <% if (item.caption) { %>data-title="<%= item.caption %>"<% } %> class="photo-card rounded-2xl overflow-hidden aspect-square fade-up block">
          <img src="<%= item.thumbnail_url || item.image_url %>" alt="<%= item.caption || 'Gallery' %>" class="gallery-image" />
        </a>
      <% }) %>
      <% if (!gallery || gallery.length === 0) { %>
        <p class="col-span-full text-center text-sage-500">Gallery coming soon.</p>
      <% } %>
    </div>
  </div>
</section>
