<div class="auth-split-layout">
  <aside class="auth-split-brand" aria-hidden="false">
    <div class="auth-split-brand__blobs">
      <span class="auth-blob auth-blob--1"></span>
      <span class="auth-blob auth-blob--2"></span>
      <span class="auth-blob auth-blob--3"></span>
      <span class="auth-blob auth-blob--4"></span>
      <span class="auth-dots"></span>
    </div>
    <div class="auth-split-brand__inner">
      <a href="/" class="auth-brand-mark">
        <span class="auth-brand-icon" aria-hidden="true">✦</span>
        <span class="auth-brand-text">Undangan Digital</span>
      </a>
      <p class="auth-tagline-sub">Platform Undangan Pernikahan Modern</p>
      <h1 class="auth-headline">Selamat datang<br />kembali.</h1>
      <div class="auth-brand-line"></div>
    </div>
    <div class="auth-split-arrow" aria-hidden="true">
      <span class="auth-split-arrow__circle">→</span>
    </div>
  </aside>

  <section class="auth-split-panel">
    <div class="auth-form-shell">
      <h2 class="auth-welcome">Masuk ke akun</h2>
      <p class="auth-welcome-sub muted">Kelola undangan pernikahan dan situs Anda.</p>

      <% if (typeof notice !== 'undefined' && notice) { %>
        <div class="flash <%= notice.type === 'error' ? 'flash-error' : 'flash-success' %> auth-inline-flash"><%= notice.text %></div>
      <% } %>
      <% if (error) { %><div class="flash flash-error auth-inline-flash"><%= error %></div><% } %>

      <form method="POST" action="/login" class="form auth-form">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <% if (typeof themeKey !== 'undefined' && themeKey) { %>
          <input type="hidden" name="theme_key" value="<%= themeKey %>" />
        <% } %>
        <label class="auth-label">
          <span class="auth-label-text">Email Address</span>
          <input type="email" name="email" class="auth-input" placeholder="Enter your email" required value="<%= typeof email !== 'undefined' ? email : '' %>" autocomplete="email" />
        </label>
        <label class="auth-label">
          <span class="auth-label-text">Password</span>
          <input type="password" name="password" class="auth-input" placeholder="Enter your password" required minlength="6" autocomplete="current-password" />
        </label>
        <button type="submit" class="btn btn-primary btn-auth-submit">Masuk</button>
      </form>

      <%- include('partials/google-oauth-button', { googleHint: 'Masuk cepat tanpa password — pakai akun Google Anda.' }) %>

      <p class="muted small auth-demo" style="border-top:1px solid var(--border);padding-top:1.25rem;margin-top:1.25rem">
        <a href="/forgot-password">Lupa password?</a>
        &middot; Belum punya akun? <a href="/register">Daftar gratis</a>
        &middot; <a href="/catalog">Lihat katalog tema</a>
      </p>
    </div>
  </section>
</div>
