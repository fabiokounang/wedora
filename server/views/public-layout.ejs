<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Undangan Digital' %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Platform undangan pernikahan digital modern. Buat undangan elegan, kirim via WhatsApp, pantau RSVP tamu — semua dalam satu platform.' %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/web/static/style.css" />
</head>
<body>
  <%
    var currentPath = typeof adminPath !== 'undefined' ? adminPath : '';
  %>
  <nav class="pub-nav" id="pub-nav">
    <div class="pub-nav__inner">
      <a href="/" class="pub-nav__logo">
        <span class="pub-nav__logo-mark">✦</span>
        <%= cms && cms.footer ? cms.footer.brandName : 'Undangan Digital' %>
      </a>

      <div class="pub-nav__links">
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Beranda</a>
        <a href="/catalog" class="<%= currentPath === '/catalog' ? 'active' : '' %>">Katalog Tema</a>
        <a href="/pricing" class="<%= currentPath === '/pricing' ? 'active' : '' %>">Harga</a>
      </div>

      <div class="pub-nav__actions">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="btn-pub btn-pub-outline btn-pub-sm">Dashboard</a>
        <% } else { %>
          <a href="/login" class="btn-pub btn-pub-outline btn-pub-sm">Masuk</a>
          <a href="/register" class="btn-pub btn-pub-sm">Mulai Gratis</a>
        <% } %>
      </div>

      <button class="pub-nav__mobile-btn" id="nav-mobile-btn" aria-label="Buka menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

    <div class="pub-nav__mobile-menu" id="nav-mobile-menu" role="navigation" aria-label="Menu mobile">
      <a href="/">Beranda</a>
      <a href="/catalog">Katalog Tema</a>
      <a href="/pricing">Harga</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard">Dashboard</a>
      <% } else { %>
        <a href="/login">Masuk</a>
        <a href="/register">Daftar Gratis</a>
      <% } %>
    </div>
  </nav>

  <main>
    <%- body %>
  </main>

  <footer class="pub-footer">
    <div class="pub-footer__inner">
      <div class="pub-footer__brand">
        <div class="pub-footer__logo">
          <span class="pub-footer__logo-mark">✦</span> <%= cms && cms.footer ? cms.footer.brandName : 'Undangan Digital' %>
        </div>
        <p class="pub-footer__tagline"><%= cms && cms.footer ? cms.footer.tagline : 'Platform undangan pernikahan digital modern untuk pasangan Indonesia.' %></p>
      </div>
      <div class="pub-footer__links">
        <h4><%= cms && cms.footer ? cms.footer.col1Title : 'Produk' %></h4>
        <a href="/catalog"><%= cms && cms.footer ? cms.footer.col1LinkCatalog : 'Katalog Tema' %></a>
        <a href="/pricing"><%= cms && cms.footer ? cms.footer.col1LinkPricing : 'Paket Harga' %></a>
      </div>
      <div class="pub-footer__links">
        <h4><%= cms && cms.footer ? cms.footer.col2Title : 'Akun' %></h4>
        <a href="/login"><%= cms && cms.footer ? cms.footer.col2LinkLogin : 'Masuk' %></a>
        <a href="/register"><%= cms && cms.footer ? cms.footer.col2LinkRegister : 'Daftar Gratis' %></a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard">Dashboard</a>
        <% } %>
      </div>
    </div>
    <div class="pub-footer__bottom">
      <p><%= cms && cms.footer ? cms.footer.bottomLine1 : '© Undangan Digital. Dibuat dengan ❤ untuk pasangan Indonesia.' %></p>
      <p><%= cms && cms.footer ? cms.footer.bottomLine2 : 'Platform undangan pernikahan digital #1' %></p>
    </div>
  </footer>

  <script>
    // Nav scroll effect
    (function () {
      var nav = document.getElementById('pub-nav');
      if (!nav) return;
      function onScroll() {
        nav.classList.toggle('scrolled', window.scrollY > 40);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();

    // Mobile menu toggle
    (function () {
      var btn = document.getElementById('nav-mobile-btn');
      var menu = document.getElementById('nav-mobile-menu');
      if (!btn || !menu) return;
      btn.addEventListener('click', function () {
        var open = menu.classList.toggle('is-open');
        btn.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      });
      // Close on outside click
      document.addEventListener('click', function (e) {
        if (!btn.contains(e.target) && !menu.contains(e.target)) {
          menu.classList.remove('is-open');
          btn.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }
      });
    })();

    // Reveal-on-scroll animation for landing/public pages
    (function () {
      var revealSelectors = [
        '.pub-section',
        '.pub-stats',
        '.pub-cta-banner',
        '.pub-feature-card',
        '.pub-step',
        '.pub-theme-card',
        '.pub-testimonial',
        '.pub-plan',
        '.pub-faq__item'
      ];

      var nodes = [];
      revealSelectors.forEach(function (selector) {
        document.querySelectorAll(selector).forEach(function (el) {
          if (el.classList.contains('pub-theme-card--catalog') ||
              (el.classList.contains('pub-theme-card') && el.closest('.pub-catalog-themes'))) {
            el.classList.add('reveal-swipe');
          } else if (el.classList.contains('pub-feature-card') ||
              el.classList.contains('pub-theme-card') ||
              el.classList.contains('pub-testimonial') ||
              el.classList.contains('pub-plan') ||
              el.classList.contains('pub-step')) {
            el.classList.add('reveal-scale');
          } else {
            el.classList.add('reveal-up');
          }
          nodes.push(el);
        });
      });

      if (!('IntersectionObserver' in window)) {
        nodes.forEach(function (el) { el.classList.add('is-visible'); });
        return;
      }

      var io = new IntersectionObserver(function (entries, observer) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });

      nodes.forEach(function (el) { io.observe(el); });
    })();

    // Catalog page: scroll hint button → themes grid
    (function () {
      var btn = document.querySelector('.pub-catalog-hero__scroll-hint');
      var target = document.getElementById('catalog-themes');
      if (!btn || !target) return;
      btn.addEventListener('click', function () {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    })();

    // Hero mouse parallax (subtle, modern)
    (function () {
      var hero = document.querySelector('.pub-hero');
      if (!hero) return;

      var isReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (isReduced) return;

      var raf = null;
      var targetX = 0;
      var targetY = 0;

      function apply() {
        hero.style.setProperty('--mx', targetX.toFixed(1) + 'px');
        hero.style.setProperty('--my', targetY.toFixed(1) + 'px');
        raf = null;
      }

      function onMove(clientX, clientY) {
        var rect = hero.getBoundingClientRect();
        var cx = rect.left + rect.width / 2;
        var cy = rect.top + rect.height / 2;
        targetX = Math.max(-42, Math.min(42, (clientX - cx) * 0.12));
        targetY = Math.max(-28, Math.min(28, (clientY - cy) * 0.12));
        if (!raf) raf = requestAnimationFrame(apply);
      }

      hero.addEventListener('mousemove', function (e) {
        onMove(e.clientX, e.clientY);
      }, { passive: true });

      hero.addEventListener('mouseleave', function () {
        targetX = 0;
        targetY = 0;
        if (!raf) raf = requestAnimationFrame(apply);
      });
    })();
  </script>
</body>
</html>
