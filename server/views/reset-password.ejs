<div class="auth-split-layout">
  <aside class="auth-split-brand" aria-hidden="false">
    <div class="auth-split-brand__blobs">
      <span class="auth-blob auth-blob--1"></span>
      <span class="auth-blob auth-blob--2"></span>
      <span class="auth-blob auth-blob--3"></span>
      <span class="auth-blob auth-blob--4"></span>
      <span class="auth-dots"></span>
    </div>
    <div class="auth-split-brand__inner">
      <a href="/" class="auth-brand-mark">
        <span class="auth-brand-icon" aria-hidden="true">✦</span>
        <span class="auth-brand-text">Undangan Digital</span>
      </a>
      <p class="auth-tagline-sub">Platform Undangan Pernikahan Modern</p>
      <h1 class="auth-headline">Password<br />baru</h1>
      <div class="auth-brand-line"></div>
    </div>
    <div class="auth-split-arrow" aria-hidden="true">
      <span class="auth-split-arrow__circle">→</span>
    </div>
  </aside>

  <section class="auth-split-panel">
    <div class="auth-form-shell">
      <h2 class="auth-welcome">Atur password baru</h2>
      <p class="auth-welcome-sub muted">Gunakan password yang kuat dan belum dipakai di situs lain.</p>

      <% if (error) { %><div class="flash flash-error auth-inline-flash"><%= error %></div><% } %>

      <% if (typeof token !== 'undefined' && token) { %>
      <form method="POST" action="/reset-password" class="form auth-form">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" name="token" value="<%= token %>" />
        <label class="auth-label">
          <span class="auth-label-text">Password baru</span>
          <input type="password" name="password" class="auth-input" placeholder="Min. 6 karakter" required minlength="6" autocomplete="new-password" />
        </label>
        <button type="submit" class="btn btn-primary btn-auth-submit">Simpan password</button>
      </form>
      <% } %>

      <p class="muted small auth-demo" style="border-top:1px solid var(--border);padding-top:1.25rem;margin-top:1.25rem">
        <a href="/login">Ke login</a>
      </p>
    </div>
  </section>
</div>
