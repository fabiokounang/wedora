<div class="auth-split-layout">
  <aside class="auth-split-brand" aria-hidden="false">
    <div class="auth-split-brand__blobs">
      <span class="auth-blob auth-blob--1"></span>
      <span class="auth-blob auth-blob--2"></span>
      <span class="auth-blob auth-blob--3"></span>
      <span class="auth-blob auth-blob--4"></span>
      <span class="auth-dots"></span>
    </div>
    <div class="auth-split-brand__inner">
      <a href="/" class="auth-brand-mark">
        <span class="auth-brand-icon" aria-hidden="true">✦</span>
        <span class="auth-brand-text">Undangan Digital</span>
      </a>
      <p class="auth-tagline-sub">Platform Undangan Pernikahan Modern</p>
      <h1 class="auth-headline">Lupa<br />password?</h1>
      <div class="auth-brand-line"></div>
    </div>
    <div class="auth-split-arrow" aria-hidden="true">
      <span class="auth-split-arrow__circle">→</span>
    </div>
  </aside>

  <section class="auth-split-panel">
    <div class="auth-form-shell">
      <h2 class="auth-welcome">Reset password</h2>
      <p class="auth-welcome-sub muted">Masukkan email akun Anda. Kami akan mengirim tautan reset jika memungkinkan.</p>

      <p class="muted small" style="margin-bottom: 1rem; line-height: 1.5">
        <strong>Masuk pakai Google?</strong> Akun tersebut tidak memakai password di situs ini — gunakan tombol <strong>Lanjutkan dengan Google</strong> di halaman login. Reset via email hanya untuk akun email + password.
      </p>

      <% if (typeof info !== 'undefined' && info) { %>
        <div class="flash flash-success auth-inline-flash"><%= info %></div>
      <% } %>
      <% if (error) { %><div class="flash flash-error auth-inline-flash"><%= error %></div><% } %>

      <% if (!(typeof info !== 'undefined' && info)) { %>
      <form method="POST" action="/forgot-password" class="form auth-form">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <label class="auth-label">
          <span class="auth-label-text">Email</span>
          <input type="email" name="email" class="auth-input" placeholder="kamu@email.com" required autocomplete="email" />
        </label>
        <button type="submit" class="btn btn-primary btn-auth-submit">Kirim tautan</button>
      </form>
      <% } %>

      <p class="muted small auth-demo" style="border-top:1px solid var(--border);padding-top:1.25rem;margin-top:1.25rem">
        <a href="/login">Kembali ke login</a>
      </p>
    </div>
  </section>
</div>
