<div class="page-header page-header--inner">
  <div>
    <p class="catalog-eyebrow" style="margin-bottom: 4px">Super admin</p>
    <h1 class="dash-title">Konten publik</h1>
    <p class="muted small">Mengatur teks halaman beranda, harga, CTA, footer, dan meta default. Harga di tabel perbandingan baris tertentu disinkronkan dari paket billing.</p>
  </div>
</div>

<% if (typeof formError !== 'undefined' && formError) { %>
  <div class="flash flash-error"><%= formError %></div>
<% } %>

<div class="public-cms-tab-bar" role="tablist" data-public-cms-tab-bar aria-label="Bagian konten publik">
  <button type="button" class="public-cms-tab is-active" role="tab" id="cms-tab-seo" data-public-cms-tab="seo" aria-controls="cms-panel-seo" aria-selected="true">SEO</button>
  <button type="button" class="public-cms-tab" role="tab" id="cms-tab-footer" data-public-cms-tab="footer" aria-controls="cms-panel-footer" aria-selected="false">Footer</button>
  <button type="button" class="public-cms-tab" role="tab" id="cms-tab-cta" data-public-cms-tab="cta" aria-controls="cms-panel-cta" aria-selected="false">CTA</button>
  <button type="button" class="public-cms-tab" role="tab" id="cms-tab-home-hero" data-public-cms-tab="home-hero" aria-controls="cms-panel-home-hero" aria-selected="false">Beranda · Hero</button>
  <button type="button" class="public-cms-tab" role="tab" id="cms-tab-home-stats" data-public-cms-tab="home-stats" aria-controls="cms-panel-home-stats" aria-selected="false">Beranda · Statistik &amp; fitur</button>
  <button type="button" class="public-cms-tab" role="tab" id="cms-tab-home-about" data-public-cms-tab="home-about" aria-controls="cms-panel-home-about" aria-selected="false">Beranda · Tentang kami</button>
  <button type="button" class="public-cms-tab" role="tab" id="cms-tab-home-mid" data-public-cms-tab="home-mid" aria-controls="cms-panel-home-mid" aria-selected="false">Beranda · Langkah &amp; testimoni</button>
  <button type="button" class="public-cms-tab" role="tab" id="cms-tab-home-preview" data-public-cms-tab="home-preview" aria-controls="cms-panel-home-preview" aria-selected="false">Beranda · Pratinjau paket</button>
  <button type="button" class="public-cms-tab" role="tab" id="cms-tab-price-hero" data-public-cms-tab="price-hero" aria-controls="cms-panel-price-hero" aria-selected="false">Harga · Hero</button>
  <button type="button" class="public-cms-tab" role="tab" id="cms-tab-price-cards" data-public-cms-tab="price-cards" aria-controls="cms-panel-price-cards" aria-selected="false">Harga · Kartu</button>
  <button type="button" class="public-cms-tab" role="tab" id="cms-tab-price-table" data-public-cms-tab="price-table" aria-controls="cms-panel-price-table" aria-selected="false">Harga · Tabel &amp; FAQ</button>
</div>

<form method="POST" action="/landing-cms" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <div id="cms-panel-seo" class="co-panel public-cms-tab-panel" role="tabpanel" aria-labelledby="cms-tab-seo" data-public-cms-tab="seo">
    <h2 class="tab-panel-title">SEO &amp; judul halaman</h2>
    <div class="admin-form__grid">
      <div class="form-group">
        <label class="form-group__label" for="seo-homeTitle">Judul halaman beranda</label>
        <input id="seo-homeTitle" class="form-group__control" type="text" name="seo[homeTitle]" maxlength="200" value="<%= cms.seo.homeTitle %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="seo-pricingTitle">Judul halaman harga</label>
        <input id="seo-pricingTitle" class="form-group__control" type="text" name="seo[pricingTitle]" maxlength="200" value="<%= cms.seo.pricingTitle %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="seo-catalogTitle">Judul halaman katalog</label>
        <input id="seo-catalogTitle" class="form-group__control" type="text" name="seo[catalogTitle]" maxlength="200" value="<%= cms.seo.catalogTitle %>" />
      </div>
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="seo-meta">Meta deskripsi default (publik)</label>
        <textarea id="seo-meta" class="form-group__control" name="seo[defaultMetaDescription]" rows="3" maxlength="600"><%= cms.seo.defaultMetaDescription %></textarea>
      </div>
    </div>
  </div>

  <div id="cms-panel-footer" class="co-panel public-cms-tab-panel" role="tabpanel" aria-labelledby="cms-tab-footer" data-public-cms-tab="footer" hidden>
    <h2 class="tab-panel-title">Footer</h2>
    <div class="admin-form__grid">
      <div class="form-group">
        <label class="form-group__label" for="ft-brand">Nama brand (logo teks)</label>
        <input id="ft-brand" class="form-group__control" type="text" name="footer[brandName]" maxlength="120" value="<%= cms.footer.brandName %>" />
      </div>
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="ft-tag">Tagline</label>
        <textarea id="ft-tag" class="form-group__control" name="footer[tagline]" rows="2" maxlength="4000"><%= cms.footer.tagline %></textarea>
      </div>
      <div class="form-group">
        <label class="form-group__label" for="ft-c1t">Judul kolom 1</label>
        <input id="ft-c1t" class="form-group__control" type="text" name="footer[col1Title]" maxlength="120" value="<%= cms.footer.col1Title %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="ft-c1a">Teks link katalog</label>
        <input id="ft-c1a" class="form-group__control" type="text" name="footer[col1LinkCatalog]" maxlength="120" value="<%= cms.footer.col1LinkCatalog %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="ft-c1b">Teks link harga</label>
        <input id="ft-c1b" class="form-group__control" type="text" name="footer[col1LinkPricing]" maxlength="120" value="<%= cms.footer.col1LinkPricing %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="ft-c2t">Judul kolom 2</label>
        <input id="ft-c2t" class="form-group__control" type="text" name="footer[col2Title]" maxlength="120" value="<%= cms.footer.col2Title %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="ft-c2a">Teks link masuk</label>
        <input id="ft-c2a" class="form-group__control" type="text" name="footer[col2LinkLogin]" maxlength="120" value="<%= cms.footer.col2LinkLogin %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="ft-c2b">Teks link daftar</label>
        <input id="ft-c2b" class="form-group__control" type="text" name="footer[col2LinkRegister]" maxlength="120" value="<%= cms.footer.col2LinkRegister %>" />
      </div>
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="ft-b1">Baris bawah 1</label>
        <input id="ft-b1" class="form-group__control" type="text" name="footer[bottomLine1]" maxlength="4000" value="<%= cms.footer.bottomLine1 %>" />
      </div>
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="ft-b2">Baris bawah 2</label>
        <input id="ft-b2" class="form-group__control" type="text" name="footer[bottomLine2]" maxlength="4000" value="<%= cms.footer.bottomLine2 %>" />
      </div>
    </div>
  </div>

  <div id="cms-panel-cta" class="co-panel public-cms-tab-panel" role="tabpanel" aria-labelledby="cms-tab-cta" data-public-cms-tab="cta" hidden>
    <h2 class="tab-panel-title">Banner CTA</h2>
    <h3 class="public-cms-subhead">Beranda</h3>
    <div class="admin-form__grid">
      <div class="form-group">
        <label class="form-group__label" for="cta-h0">Judul baris 1</label>
        <input id="cta-h0" class="form-group__control" type="text" name="cta[home][titleLines][0]" maxlength="500" value="<%= (cms.cta.home.titleLines && cms.cta.home.titleLines[0]) || '' %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="cta-h1">Judul baris 2</label>
        <input id="cta-h1" class="form-group__control" type="text" name="cta[home][titleLines][1]" maxlength="500" value="<%= (cms.cta.home.titleLines && cms.cta.home.titleLines[1]) || '' %>" />
      </div>
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="cta-hs">Subtitle</label>
        <textarea id="cta-hs" class="form-group__control" name="cta[home][subtitle]" rows="2" maxlength="4000"><%= cms.cta.home.subtitle %></textarea>
      </div>
      <div class="form-group">
        <label class="form-group__label" for="cta-hp">Label tombol utama</label>
        <input id="cta-hp" class="form-group__control" type="text" name="cta[home][primaryLabel]" maxlength="120" value="<%= cms.cta.home.primaryLabel %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="cta-hs2">Label tombol sekunder</label>
        <input id="cta-hs2" class="form-group__control" type="text" name="cta[home][secondaryLabel]" maxlength="120" value="<%= cms.cta.home.secondaryLabel %>" />
      </div>
    </div>
    <h3 class="public-cms-subhead">Halaman harga</h3>
    <div class="admin-form__grid">
      <div class="form-group">
        <label class="form-group__label" for="cta-p0">Judul baris 1</label>
        <input id="cta-p0" class="form-group__control" type="text" name="cta[pricing][titleLines][0]" maxlength="500" value="<%= (cms.cta.pricing.titleLines && cms.cta.pricing.titleLines[0]) || '' %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="cta-p1">Judul baris 2</label>
        <input id="cta-p1" class="form-group__control" type="text" name="cta[pricing][titleLines][1]" maxlength="500" value="<%= (cms.cta.pricing.titleLines && cms.cta.pricing.titleLines[1]) || '' %>" />
      </div>
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="cta-ps">Subtitle</label>
        <textarea id="cta-ps" class="form-group__control" name="cta[pricing][subtitle]" rows="2" maxlength="4000"><%= cms.cta.pricing.subtitle %></textarea>
      </div>
      <div class="form-group">
        <label class="form-group__label" for="cta-pp">Label tombol utama</label>
        <input id="cta-pp" class="form-group__control" type="text" name="cta[pricing][primaryLabel]" maxlength="120" value="<%= cms.cta.pricing.primaryLabel %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="cta-ps2">Label tombol sekunder</label>
        <input id="cta-ps2" class="form-group__control" type="text" name="cta[pricing][secondaryLabel]" maxlength="120" value="<%= cms.cta.pricing.secondaryLabel %>" />
      </div>
    </div>
    <p class="muted small">Tombol mengarah ke <code>/register</code> dan <code>/catalog</code> (tetap di kode).</p>
  </div>

  <div id="cms-panel-home-hero" class="co-panel public-cms-tab-panel" role="tabpanel" aria-labelledby="cms-tab-home-hero" data-public-cms-tab="home-hero" hidden>
    <h2 class="tab-panel-title">Beranda — Hero</h2>
    <div class="admin-form__grid">
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="hh-ey">Eyebrow</label>
        <input id="hh-ey" class="form-group__control" type="text" name="home[hero][eyebrow]" maxlength="500" value="<%= cms.home.hero.eyebrow %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="hh-t1">Judul baris 1</label>
        <input id="hh-t1" class="form-group__control" type="text" name="home[hero][titleLine1]" maxlength="500" value="<%= cms.home.hero.titleLine1 %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="hh-em">Kata penekanan (miring)</label>
        <input id="hh-em" class="form-group__control" type="text" name="home[hero][titleEmphasis]" maxlength="120" value="<%= cms.home.hero.titleEmphasis %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="hh-t2">Judul baris 2</label>
        <input id="hh-t2" class="form-group__control" type="text" name="home[hero][titleLine2]" maxlength="500" value="<%= cms.home.hero.titleLine2 %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="hh-t3">Judul baris 3</label>
        <input id="hh-t3" class="form-group__control" type="text" name="home[hero][titleLine3]" maxlength="500" value="<%= cms.home.hero.titleLine3 %>" />
      </div>
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="hh-sub">Subtitle</label>
        <textarea id="hh-sub" class="form-group__control" name="home[hero][subtitle]" rows="3" maxlength="4000"><%= cms.home.hero.subtitle %></textarea>
      </div>
      <div class="form-group">
        <label class="form-group__label" for="hh-c1">CTA primer</label>
        <input id="hh-c1" class="form-group__control" type="text" name="home[hero][ctaPrimary]" maxlength="120" value="<%= cms.home.hero.ctaPrimary %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="hh-c2">CTA sekunder</label>
        <input id="hh-c2" class="form-group__control" type="text" name="home[hero][ctaSecondary]" maxlength="120" value="<%= cms.home.hero.ctaSecondary %>" />
      </div>
    </div>
  </div>

  <div id="cms-panel-home-stats" class="co-panel public-cms-tab-panel" role="tabpanel" aria-labelledby="cms-tab-home-stats" data-public-cms-tab="home-stats" hidden>
    <h2 class="tab-panel-title">Beranda — Statistik &amp; fitur</h2>

    <h3 class="public-cms-subhead">Statistik (bar di beranda)</h3>
    <p class="public-cms-hint">Isi angka/teks dan label untuk tiap kotak. Centang &ldquo;Gunakan jumlah tema&rdquo; bila angka harus mengikuti banyaknya tema di katalog (teks angka diabaikan).</p>
    <% var statsList = cms.home.stats || []; %>
    <% for (var si = 0; si < 6; si++) { var st = statsList[si] || {}; %>
      <div class="public-cms-block">
        <p class="public-cms-block__legend">Statistik <%= si + 1 %></p>
        <div class="admin-form__grid">
          <div class="form-group">
            <label class="form-group__label" for="st-<%= si %>-val">Angka atau teks singkat</label>
            <input id="st-<%= si %>-val" class="form-group__control" type="text" name="home[stats][<%= si %>][val]" maxlength="120" value="<%= st.val != null ? String(st.val) : '' %>" />
          </div>
          <div class="form-group">
            <label class="form-group__label" for="st-<%= si %>-lab">Label (teks di bawah angka)</label>
            <input id="st-<%= si %>-lab" class="form-group__control" type="text" name="home[stats][<%= si %>][label]" maxlength="120" value="<%= st.label != null ? String(st.label) : '' %>" />
          </div>
          <div class="form-group form-group--span-2">
            <label class="form-group__label switch" for="st-<%= si %>-utc">
              <input id="st-<%= si %>-utc" type="checkbox" name="home[stats][<%= si %>][useThemeCount]" value="1" <%= st.useThemeCount ? 'checked' : '' %> />
              <span>Gunakan jumlah tema otomatis (bukan teks di atas)</span>
            </label>
          </div>
        </div>
      </div>
    <% } %>

    <h3 class="public-cms-subhead">Seksi fitur</h3>
    <div class="admin-form__grid">
      <div class="form-group">
        <label class="form-group__label" for="hf-ey">Eyebrow</label>
        <input id="hf-ey" class="form-group__control" type="text" name="home[featuresSection][eyebrow]" maxlength="500" value="<%= cms.home.featuresSection.eyebrow %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="hf-t0">Judul baris 1</label>
        <input id="hf-t0" class="form-group__control" type="text" name="home[featuresSection][titleLines][0]" maxlength="500" value="<%= (cms.home.featuresSection.titleLines && cms.home.featuresSection.titleLines[0]) || '' %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="hf-t1">Judul baris 2</label>
        <input id="hf-t1" class="form-group__control" type="text" name="home[featuresSection][titleLines][1]" maxlength="500" value="<%= (cms.home.featuresSection.titleLines && cms.home.featuresSection.titleLines[1]) || '' %>" />
      </div>
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="hf-sub">Subtitle</label>
        <textarea id="hf-sub" class="form-group__control" name="home[featuresSection][subtitle]" rows="2" maxlength="4000"><%= cms.home.featuresSection.subtitle %></textarea>
      </div>
    </div>
    <p class="public-cms-hint">Maksimal 6 kartu fitur. Emoji opsional di kolom ikon (mis. 🎨).</p>
    <% var featList = cms.home.features || []; %>
    <% for (var fi = 0; fi < 6; fi++) { var f = featList[fi] || {}; %>
      <div class="public-cms-block">
        <p class="public-cms-block__legend">Fitur <%= fi + 1 %></p>
        <div class="admin-form__grid">
          <div class="form-group">
            <label class="form-group__label" for="feat-<%= fi %>-ic">Ikon (emoji)</label>
            <input id="feat-<%= fi %>-ic" class="form-group__control" type="text" name="home[features][<%= fi %>][icon]" maxlength="16" value="<%= f.icon != null ? String(f.icon) : '' %>" />
          </div>
          <div class="form-group">
            <label class="form-group__label" for="feat-<%= fi %>-ti">Judul</label>
            <input id="feat-<%= fi %>-ti" class="form-group__control" type="text" name="home[features][<%= fi %>][title]" maxlength="500" value="<%= f.title != null ? String(f.title) : '' %>" />
          </div>
          <div class="form-group form-group--span-2">
            <label class="form-group__label" for="feat-<%= fi %>-de">Deskripsi</label>
            <textarea id="feat-<%= fi %>-de" class="form-group__control" name="home[features][<%= fi %>][desc]" rows="2" maxlength="4000"><%= f.desc != null ? String(f.desc) : '' %></textarea>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <div id="cms-panel-home-about" class="co-panel public-cms-tab-panel" role="tabpanel" aria-labelledby="cms-tab-home-about" data-public-cms-tab="home-about" hidden>
    <h2 class="tab-panel-title">Beranda — Tentang kami</h2>
    <% var ab = cms.home.aboutSection || {}; %>
    <div class="admin-form__grid">
      <div class="form-group">
        <label class="form-group__label" for="ab-ey">Eyebrow</label>
        <input id="ab-ey" class="form-group__control" type="text" name="home[aboutSection][eyebrow]" maxlength="500" value="<%= ab.eyebrow || '' %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="ab-t0">Judul baris 1</label>
        <input id="ab-t0" class="form-group__control" type="text" name="home[aboutSection][titleLines][0]" maxlength="500" value="<%= (ab.titleLines && ab.titleLines[0]) || '' %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="ab-t1">Judul baris 2</label>
        <input id="ab-t1" class="form-group__control" type="text" name="home[aboutSection][titleLines][1]" maxlength="500" value="<%= (ab.titleLines && ab.titleLines[1]) || '' %>" />
      </div>
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="ab-body">Cerita / paragraf utama</label>
        <textarea id="ab-body" class="form-group__control" name="home[aboutSection][body]" rows="4" maxlength="4000"><%= ab.body || '' %></textarea>
      </div>
    </div>
    <p class="public-cms-hint">Tiga kartu &ldquo;highlight&rdquo; opsional di bawah cerita (icon emoji + judul + deskripsi singkat). Kosongkan baris yang tidak dipakai.</p>
    <% var hlList = ab.highlights || []; %>
    <% for (var hi = 0; hi < 3; hi++) { var hl = hlList[hi] || {}; %>
      <div class="public-cms-block">
        <p class="public-cms-block__legend">Highlight <%= hi + 1 %></p>
        <div class="admin-form__grid">
          <div class="form-group">
            <label class="form-group__label" for="hl-<%= hi %>-ic">Ikon (emoji)</label>
            <input id="hl-<%= hi %>-ic" class="form-group__control" type="text" name="home[aboutSection][highlights][<%= hi %>][icon]" maxlength="16" value="<%= hl.icon != null ? String(hl.icon) : '' %>" />
          </div>
          <div class="form-group">
            <label class="form-group__label" for="hl-<%= hi %>-ti">Judul</label>
            <input id="hl-<%= hi %>-ti" class="form-group__control" type="text" name="home[aboutSection][highlights][<%= hi %>][title]" maxlength="500" value="<%= hl.title != null ? String(hl.title) : '' %>" />
          </div>
          <div class="form-group form-group--span-2">
            <label class="form-group__label" for="hl-<%= hi %>-de">Deskripsi singkat</label>
            <textarea id="hl-<%= hi %>-de" class="form-group__control" name="home[aboutSection][highlights][<%= hi %>][desc]" rows="2" maxlength="4000"><%= hl.desc != null ? String(hl.desc) : '' %></textarea>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <div id="cms-panel-home-mid" class="co-panel public-cms-tab-panel" role="tabpanel" aria-labelledby="cms-tab-home-mid" data-public-cms-tab="home-mid" hidden>
    <h2 class="tab-panel-title">Beranda — Langkah, tema &amp; testimoni</h2>

    <h3 class="public-cms-subhead">Langkah &amp; tema</h3>
    <div class="admin-form__grid">
      <div class="form-group">
        <label class="form-group__label" for="hs-ey">Eyebrow langkah</label>
        <input id="hs-ey" class="form-group__control" type="text" name="home[stepsSection][eyebrow]" maxlength="500" value="<%= cms.home.stepsSection.eyebrow %>" />
      </div>
      <div class="form-group">
        <label class="form-group__label" for="hs-ti">Judul langkah</label>
        <input id="hs-ti" class="form-group__control" type="text" name="home[stepsSection][title]" maxlength="500" value="<%= cms.home.stepsSection.title %>" />
      </div>
      <div class="form-group form-group--span-2">
        <label class="form-group__label" for="hs-su">Subtitle langkah</label>
        <textarea id="hs-su" class="form-group__control" name="home[stepsSection][subtitle]" rows="2" maxlength="4000"><%= cms.home.stepsSection.subtitle %></textarea>
      </div>
    </div>
    <p class="public-cms-hint">Tiga langkah utama di beranda (boleh dikosongkan baris yang tidak dipakai).</p>
