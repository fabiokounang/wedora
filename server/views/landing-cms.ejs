<script>
(function () {
  var bar = document.querySelector('[data-public-cms-tab-bar]');
  if (!bar) return;
  var tabs = bar.querySelectorAll('.public-cms-tab[role="tab"]');
  var panels = document.querySelectorAll('.public-cms-tab-panel[role="tabpanel"]');
  function show(id) {
    tabs.forEach(function (t) {
      var on = t.getAttribute('data-public-cms-tab') === id;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.classList.toggle('is-active', on);
      t.tabIndex = on ? 0 : -1;
    });
    panels.forEach(function (p) {
      var on = p.getAttribute('data-public-cms-tab') === id;
      if (on) p.removeAttribute('hidden');
      else p.setAttribute('hidden', '');
    });
    try {
      history.replaceState(null, '', '#cms-' + id);
    } catch (e) {}
  }
  bar.addEventListener('click', function (e) {
    var btn = e.target.closest('.public-cms-tab');
    if (!btn || !bar.contains(btn)) return;
    e.preventDefault();
    show(btn.getAttribute('data-public-cms-tab'));
  });
  var initial = (window.location.hash || '').replace(/^#cms-/, '');
  var valid = false;
  tabs.forEach(function (t) {
    if (t.getAttribute('data-public-cms-tab') === initial) valid = true;
  });
  var first = tabs[0] && tabs[0].getAttribute('data-public-cms-tab');
  show(valid && initial ? initial : first || 'seo');
})();
</script>
