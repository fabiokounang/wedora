<div class="auth-split-layout">
  <aside class="auth-split-brand" aria-hidden="false">
    <div class="auth-split-brand__blobs">
      <span class="auth-blob auth-blob--1"></span>
      <span class="auth-blob auth-blob--2"></span>
      <span class="auth-blob auth-blob--3"></span>
      <span class="auth-blob auth-blob--4"></span>
      <span class="auth-dots"></span>
    </div>
    <div class="auth-split-brand__inner">
      <a href="/" class="auth-brand-mark">
        <span class="auth-brand-icon" aria-hidden="true">✦</span>
        <span class="auth-brand-text">Undangan Digital</span>
      </a>
      <p class="auth-tagline-sub">Platform Undangan Pernikahan Modern</p>
      <h1 class="auth-headline">Mulai buat<br />undangan impian.</h1>
      <div class="auth-brand-line"></div>
    </div>
    <div class="auth-split-arrow" aria-hidden="true">
      <span class="auth-split-arrow__circle">→</span>
    </div>
  </aside>

  <section class="auth-split-panel">
    <div class="auth-form-shell">
      <h2 class="auth-welcome">Buat akun gratis</h2>
      <p class="auth-welcome-sub muted">Daftar dan mulai buat undangan pernikahan digitalmu.</p>

      <% if (error) { %><div class="flash flash-error auth-inline-flash"><%= error %></div><% } %>
      <% if (typeof prefillTheme !== 'undefined' && prefillTheme) { %>
        <div class="flash flash-success auth-inline-flash" style="margin-bottom:1rem">
          Tema pilihan: <strong><%= prefillTheme %></strong> — setelah daftar &amp; masuk, Anda akan diarahkan membuat undangan dengan tema ini.
        </div>
      <% } %>

      <form method="POST" action="/register" class="form auth-form">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <% if (typeof prefillTheme !== 'undefined' && prefillTheme) { %>
          <input type="hidden" name="theme_key" value="<%= prefillTheme %>" />
        <% } %>
        <label class="auth-label">
          <span class="auth-label-text">Nama lengkap</span>
          <input type="text" name="name" class="auth-input" placeholder="Nama kamu" required maxlength="120" autocomplete="name" />
        </label>
        <label class="auth-label">
          <span class="auth-label-text">Email</span>
          <input type="email" name="email" class="auth-input" placeholder="kamu@email.com" required autocomplete="email" />
        </label>
        <label class="auth-label">
          <span class="auth-label-text">Password</span>
          <input type="password" name="password" class="auth-input" placeholder="Min. 6 karakter" required minlength="6" autocomplete="new-password" />
        </label>
        <button type="submit" class="btn btn-primary btn-auth-submit">Daftar sekarang</button>
      </form>

      <%- include('partials/google-oauth-button', { googleHint: 'Daftar dengan Google — tidak perlu buat password di sini.' }) %>

      <p class="muted small auth-demo" style="border-top:1px solid var(--border);padding-top:1.25rem;margin-top:1.25rem">
        Sudah punya akun? <a href="/login">Masuk</a>
        &middot; <a href="/catalog">Lihat katalog tema</a>
      </p>
    </div>
  </section>
</div>
