# --- Server ---
PORT=3000
NODE_ENV=development
BASE_DOMAIN=localhost:3000
# Optional: absolute public URL for theme demo links in /theme-gallery (defaults to request host)
# PUBLIC_APP_URL=https://your-domain.com

# --- Database (MySQL lokal / TiDB Cloud / PlanetScale) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=wedding_saas
# TiDB Cloud: DB_PORT=4000, DB_SSL=true (wajib TLS)
# DB_SSL=true
# DB_SSL_CA=/path/to/ca.pem
# atau DB_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n..."
# DB_SSL_REJECT_UNAUTHORIZED=false
# Jika DB sudah dibuat di panel (tanpa hak CREATE DATABASE): DB_SKIP_CREATE_DATABASE=true
# Max concurrent connections in pool (scale ~100+ sites: tune up slowly; default 10)
DB_POOL_CONNECTION_LIMIT=10
# Optional MySQL driver connect timeout (ms)
# DB_CONNECT_TIMEOUT_MS=15000

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
COOKIE_NAME=wsaas_token
COOKIE_SECURE=false
# Optional strict gate: billing + create site require verified email (see docs/production-checklist.md).
REQUIRE_EMAIL_VERIFIED=false

# --- Outbound email (password reset & email verification) ---
# Tanpa MAIL_SMTP_HOST + MAIL_FROM, email tidak dikirim (dev OK). Halaman /settings menampilkan status SMTP.
MAIL_FROM="Undangan Digital <noreply@example.com>"
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
# true = port 465 (SSL). false + port 587 = STARTTLS (umum Gmail/Outlook).
MAIL_SMTP_SECURE=false
# Untuk port 587 default true — wajib STARTTLS kebanyakan penyedia.
MAIL_SMTP_REQUIRE_TLS=true
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# Saat boot, coba koneksi SMTP (log saja, tidak menghentikan server). Set false untuk skip.
MAIL_VERIFY_ON_START=true
# Timeout koneksi SMTP (ms)
MAIL_SMTP_CONNECTION_TIMEOUT_MS=15000
MAIL_SMTP_GREETING_TIMEOUT_MS=15000
# Self-signed relay dev: set false (hati-hati production)
MAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true

# Contoh Gmail (App Password): MAIL_SMTP_HOST=smtp.gmail.com MAIL_SMTP_PORT=587 MAIL_SMTP_USER=email@gmail.com MAIL_SMTP_PASS=app-password
# Contoh SendGrid: MAIL_SMTP_HOST=smtp.sendgrid.net MAIL_SMTP_PORT=587 MAIL_SMTP_USER=apikey MAIL_SMTP_PASS=SG.xxx
# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# WAJIB sama persis dengan "Authorized redirect URIs" di Google Cloud Console (Credentials → OAuth client).
# Contoh lokal (pilih SATU yang dipakai di browser, atau daftarkan keduanya di Console):
#   GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Jika Anda buka app lewat http://127.0.0.1:3000, redirect harus pakai 127.0.0.1 (bukan localhost), atau tambahkan URI itu di Console.
# Tanpa baris ini, redirect diambil dari PUBLIC_APP_URL atau Host request — sering mismatch jika beda host/port/https.
GOOGLE_OAUTH_REDIRECT_URI=

# --- E2E only: capture reset/verify URLs in memory for Playwright (requires NODE_ENV=test) ---
# E2E_CAPTURE_MAIL=1

# --- Security ---
# Number of trusted reverse-proxy hops (default 1; set 0 if no proxy)
TRUST_PROXY_HOPS=1
# Guest RSVP/wish API: per IP + slug (default 30 writes / 15 min, 300 GET wishes / 10 min)
# PUBLIC_RSVP_WISH_WRITE_MAX=30
# PUBLIC_RSVP_WISH_WRITE_WINDOW_MS=900000
# PUBLIC_WISHES_READ_MAX=300
# PUBLIC_WISHES_READ_WINDOW_MS=600000
# Login/register brute-force (default 45 login / 15 min, 20 register / hour)
# AUTH_LOGIN_MAX=45
# AUTH_REGISTER_MAX=20
# Resend verification email (default 5 / hour per user)
# RESEND_VERIFY_MAX=5
# Cache-Control for theme static assets in production (ms; default 3600000 = 1h)
# THEME_PUBLIC_MAX_AGE_MS=3600000

# --- Observability (optional) ---
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Database restore safety ---
# Required when running: npm run db:restore -- ../backups/file.sql.gz
# DB_RESTORE_CONFIRM=yes

# --- Media ---
UPLOAD_DIR=../uploads
PUBLIC_UPLOAD_URL=/uploads

# --- Midtrans ---
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
CORE_URL_WEBHOOK=http://localhost:3000/vendor/midtrans/webhook
MIDTRANS_OVERRIDE_NOTIFICATION_URL=
